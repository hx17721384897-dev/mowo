NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgresql://postgres:change_me@localhost:5432/mowo_db

JWT_SECRET=replace_with_a_long_random_jwt_secret
COOKIE_SECRET=replace_with_a_different_long_random_cookie_secret
CORS_ORIGIN=http://127.0.0.1:5500,http://127.0.0.1:5501,http://localhost:5500,http://localhost:5501,http://localhost:3000
CURRENT_PRIVACY_VERSION=dev-2026-08
CURRENT_USER_AGREEMENT_VERSION=test-2026-08
PASSWORD_LOGIN_ENABLED=false

# Initial release gates. Keep future code, but deny these capabilities at runtime.
COMMUNITY_ENABLED=false
CREATOR_FINANCE_ENABLED=false
BULL_SYSTEM_ENABLED=false
MOCK_CERTIFICATION_ENABLED=false
CREATOR_COLLAB_SELF_SERVICE_ENABLED=false

# Local development stores private test files on this computer. Production must use oss.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/private
FILE_SIGNING_SECRET=replace_with_a_third_long_random_secret

# Unused or replaced avatars are deleted after 24 hours. Cleanup runs hourly.
AVATAR_ORPHAN_RETENTION_HOURS=24
PRIVATE_FILE_CLEANUP_INTERVAL_MINUTES=60

# Eligible requests can be cancelled during the short protection window.
ACCOUNT_DELETION_GRACE_MINUTES=10
ACCOUNT_DELETION_RETRY_MINUTES=15
ACCOUNT_DELETION_MANUAL_AFTER_ATTEMPTS=3
ACCOUNT_DELETION_MANUAL_AFTER_MINUTES=60
ACCOUNT_DELETION_JOB_INTERVAL_MINUTES=1

OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=replace_with_oss_access_key_id
OSS_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret
OSS_BUCKET=replace_with_oss_bucket

# Local development can use mock SMS. Production must set this to false.
SMS_MOCK=true
ALI_SMS_ACCESS_KEY=
ALI_SMS_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_LOGIN=

# Demo seed data is disabled unless both values are explicitly supplied.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
