// ================================================================
// 哞屋 MOWO 平台 — Prisma Schema
// 数据库：PostgreSQL
// 共25张表
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// 第一组：用户与身份（7张表 + 账户系统v1新增6张）
// ================================================================

// v1 新增：用户状态枚举
enum UserStatus {
  ACTIVE // 正常
  LIMITED // 限制（不能进行资金操作）
  SUSPENDED // 已封禁
  PENDING_DELETE // 注销处理中（最长48小时，清理开始前可撤销）
  DELETED // 已注销（PIPL软删除）
}

// v1 新增：短信用途枚举
enum SmsPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  BIND_PHONE
  DEACTIVATE
  STEP_UP_WITHDRAW
  STEP_UP_CHANGE_PAYOUT
  STEP_UP_CHANGE_PASSWORD
}

// v1 新增：高危操作Token类型枚举
enum ActionType {
  WITHDRAW
  CHANGE_PAYOUT_ACCOUNT
  CHANGE_PASSWORD
  CHANGE_PHONE
}

enum StaffRole {
  OWNER
  CUSTOMER_SERVICE
  PRODUCTION
  COLLAB_OPS
}

model User {
  id            String     @id @default(uuid())
  phone         String?    @unique // v1：可为空（WeChat-only用户预留）
  passwordHash  String?    @map("password_hash") // v1：可为空（SMS注册用户 / 注销匿名化）
  certifyStatus Int        @default(0) @map("certify_status") // 0未申请 1审核中 2通过 3拒绝（兼容保留）
  isBanned      Boolean    @default(false) @map("is_banned") // 兼容保留，v1用status
  role          Int        @default(0) // 0=User 1=Production 2=Admin 3=SuperAdmin（兼容保留）
  staffRole     StaffRole? @map("staff_role") // 固定员工岗位；普通用户为空
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // v1 新增：用户状态与隐私合规字段
  status               UserStatus @default(ACTIVE) // 账号状态
  wechatOpenid         String?    @unique @map("wechat_openid") // 微信登录预留
  wechatUnionid        String?    @unique @map("wechat_unionid") // 微信联合ID预留
  deletedAt            DateTime?  @map("deleted_at") // 最终完成注销的时间
  deleteReason         String?    @map("delete_reason") @db.VarChar(500) // 注销原因
  privacyAgreedAt      DateTime?  @map("privacy_agreed_at") // 首次同意隐私协议时间戳
  privacyPolicyVersion String?    @map("privacy_policy_version") @db.VarChar(20) // 同意时协议版本

  profile             UserProfile?
  creatorProfile      CreatorProfile?
  certifyApplications CertifyApplication[]
  creditScore         CreditScore?
  creditLogs          CreditLog[]
  reportsMade         Report[]             @relation("ReporterRelation")
  articles            Article[]
  comments            Comment[]
  likes               Like[]
  collects            Collect[]
  following           Follow[]             @relation("FollowerRelation")
  followers           Follow[]             @relation("FollowingRelation")
  animations          Animation[]
  products            Product[]
  earnings            Earning[]
  balance             Balance?
  withdrawalRequests  WithdrawalRequest[]
  customizeOrders     CustomizeOrder[]
  creatorReserve      CreatorReserve?
  reserveLogs         ReserveLog[]
  settlementRecords   SettlementRecord[]
  settledRecords      SettlementRecord[]   @relation("SettlementAdmin")
  bullScores          BullScore[]
  bullScoreLogs       BullScoreLog[]
  referralLink        CreatorReferralLink?
  configsUpdated      PlatformConfig[]     @relation("ConfigUpdater")
  socialLinks         CreatorSocialLink[]
  contracts           CreatorContract[]    @relation("ContractCreator")
  contractsCreated    CreatorContract[]    @relation("ContractAdmin")

  // v1 新增关联
  smsCodes      SmsCode[]
  refreshTokens RefreshToken[]
  actionTokens  ActionToken[]
  auditLogs     AuditLog[]

  // 收货地址
  addresses UserAddress[]

  // 创作者通知
  notifications                 CreatorNotification[]
  aftersaleRequests             AftersaleRequest[]
  privateFiles                  PrivateFile[]
  deletionRequest               AccountDeletionRequest?
  customizationRequests         CustomizationRequest[]        @relation("CustomizationRequester")
  customizationEvents           CustomizationRequestEvent[]   @relation("CustomizationEventActor")
  assignedCustomizationRequests CustomizationRequest[]        @relation("CustomizationAssignee")
  customizationFrameSelections  CustomizationFrameSelection[] @relation("CustomizationFrameSelectionStaff")
  animationAssetsOwned          AnimationAsset[]              @relation("AnimationAssetOwner")
  animationAssetsCreated        AnimationAsset[]              @relation("AnimationAssetCreator")
  animationVersionsCreated      AnimationAssetVersion[]       @relation("AnimationVersionCreator")
  frameAssetDraftsCreated       FrameAssetDraft[]             @relation("FrameAssetDraftCreator")
  frameAssetDraftsEdited        FrameAssetDraft[]             @relation("FrameAssetDraftEditor")
  frameAssetDraftsOwned         FrameAssetDraft[]             @relation("FrameAssetDraftOwner")
  salesOrders                   SalesOrder[]

  @@map("users")
}

model AccountDeletionRequest {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  status              String    @default("REQUESTED") @db.VarChar(20)
  requestedAt         DateTime  @default(now()) @map("requested_at")
  scheduledAt         DateTime  @map("scheduled_at")
  processingStartedAt DateTime? @map("processing_started_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  blockers            Json?
  attemptCount        Int       @default(0) @map("attempt_count")
  nextRetryAt         DateTime? @map("next_retry_at")
  firstFailedAt       DateTime? @map("first_failed_at")
  manualReviewAt      DateTime? @map("manual_review_at")
  pausedAt            DateTime? @map("paused_at")
  pausedBy            String?   @map("paused_by")
  pauseReason         String?   @map("pause_reason") @db.VarChar(500)
  pauseUserMessage    String?   @map("pause_user_message") @db.VarChar(300)
  resumedAt           DateTime? @map("resumed_at")
  lastManualActionAt  DateTime? @map("last_manual_action_at")
  lastManualActionBy  String?   @map("last_manual_action_by")
  lastError           String?   @map("last_error") @db.VarChar(1000)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@map("account_deletion_requests")
}

// 私有上传文件登记。业务表仍保留 objectKey，本表负责用途、所有权、校验状态和访问控制。
model PrivateFile {
  id                 String    @id @default(uuid())
  ownerUserId        String?   @map("owner_user_id")
  anonymousOwnerHash String?   @map("anonymous_owner_hash") @db.VarChar(64)
  purpose            String    @db.VarChar(40)
  storageProvider    String    @default("local") @map("storage_provider") @db.VarChar(20)
  objectKey          String    @unique @map("object_key") @db.VarChar(500)
  originalName       String    @map("original_name") @db.VarChar(255)
  declaredMimeType   String    @map("declared_mime_type") @db.VarChar(150)
  detectedMimeType   String?   @map("detected_mime_type") @db.VarChar(150)
  declaredSizeBytes  Int       @map("declared_size_bytes")
  sizeBytes          Int?      @map("size_bytes")
  sha256             String?   @db.VarChar(64)
  status             String    @default("PENDING") @db.VarChar(20)
  uploadTokenHash    String?   @map("upload_token_hash") @db.VarChar(64)
  uploadExpiresAt    DateTime? @map("upload_expires_at")
  linkedResourceType String?   @map("linked_resource_type") @db.VarChar(40)
  linkedResourceId   String?   @map("linked_resource_id") @db.VarChar(100)
  uploadedAt         DateTime? @map("uploaded_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([purpose, status])
  @@index([linkedResourceType, linkedResourceId])
  @@map("private_files")
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  nickname       String?   @db.VarChar(50)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  bio            String?   @db.Text
  gender         Int       @default(0) // 0保密 1男 2女
  birthday       DateTime? @db.Date
  city           String?   @db.VarChar(50)
  mbti           String?   @db.VarChar(4)
  email          String?   @db.VarChar(100)
  followerCount  Int       @default(0) @map("follower_count")
  followingCount Int       @default(0) @map("following_count")
  articleCount   Int       @default(0) @map("article_count")
  likedCount     Int       @default(0) @map("liked_count")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // v1 新增：登录安全字段
  loginFailCount   Int       @default(0) @map("login_fail_count") // 连续登录失败次数
  loginLockedUntil DateTime? @map("login_locked_until") // 锁定到期时间
  lastLoginIp      String?   @map("last_login_ip") @db.VarChar(50) // 最后登录IP
  lastLoginAt      DateTime? @map("last_login_at_v1") // 最后登录时间（profile版）

  // 昵称修改频率控制
  nicknameUpdatedAt DateTime? @map("nickname_updated_at")

  // 通知设置（默认全开）
  notifyInteraction Boolean @default(true) @map("notify_interaction")
  notifyOrder       Boolean @default(true) @map("notify_order")
  notifySystem      Boolean @default(true) @map("notify_system")
  notifyPromo       Boolean @default(true) @map("notify_promo")

  // 隐私设置（public | followers | private）
  profileVisibility String @default("public") @map("profile_visibility") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model CreatorProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  styleTags          String?   @map("style_tags") @db.VarChar(500)
  weiboUrl           String?   @map("weibo_url") @db.VarChar(500)
  xiaohongshuUrl     String?   @map("xiaohongshu_url") @db.VarChar(500)
  bilibiliUrl        String?   @map("bilibili_url") @db.VarChar(500)
  totalSales         Int       @default(0) @map("total_sales")
  productCount       Int       @default(0) @map("product_count")
  // 牛量系统（阶段2填逻辑，字段先预留）
  bullLevel          Int       @default(1) @map("bull_level") // 1=萌牛 2=勤牛 3=红牛 4=神牛 5=牛王
  bullScore          Float     @default(0) @map("bull_score") // 综合牛量积分
  bullCoefficient    Float     @default(1.0) @map("bull_coefficient") // 牛量系数 0.8~2.0
  // 签约体系（阶段3填逻辑）
  isExclusive        Boolean   @default(false) @map("is_exclusive")
  exclusiveSignedAt  DateTime? @map("exclusive_signed_at")
  exclusiveExpiredAt DateTime? @map("exclusive_expired_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("creator_profiles")
}

model CertifyApplication {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  creatorName        String    @map("creator_name") @db.VarChar(100)
  creatorType        String    @map("creator_type") @db.VarChar(20)
  mainStyle          String?   @map("main_style") @db.VarChar(500)
  portfolioUrls      String?   @map("portfolio_urls") @db.Text
  realName           String    @map("real_name") @db.VarChar(50)
  idNumberLast4      String    @map("id_number_last4") @db.VarChar(4)
  certifyPassed      Boolean   @default(false) @map("certify_passed")
  copyrightConfirmed Boolean   @default(false) @map("copyright_confirmed")
  agreementConfirmed Boolean   @default(false) @map("agreement_confirmed")
  status             String    @default("pending") @db.VarChar(20)
  rejectReason       String?   @map("reject_reason") @db.VarChar(500)
  appliedAt          DateTime  @default(now()) @map("applied_at")
  reviewedAt         DateTime? @map("reviewed_at")

  user User @relation(fields: [userId], references: [id])

  @@map("certify_applications")
}

model CreditScore {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  score     Int      @default(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_scores")
}

model CreditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  delta     Int
  reason    String   @db.VarChar(100)
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_logs")
}

model Report {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  targetType  String    @map("target_type") @db.VarChar(20)
  targetId    String    @map("target_id")
  reason      String    @db.VarChar(50)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(20)
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id])

  @@map("reports")
}

// ================================================================
// 第二组：文章与社区（6张表）
// ================================================================

model Article {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String   @db.VarChar(200)
  content      String   @db.Text
  coverUrl     String?  @map("cover_url") @db.VarChar(500)
  tags         String?  @db.VarChar(500)
  status       String   @default("pending") @db.VarChar(20)
  rejectReason String?  @map("reject_reason") @db.VarChar(500)
  viewCount    Int      @default(0) @map("view_count")
  likeCount    Int      @default(0) @map("like_count")
  collectCount Int      @default(0) @map("collect_count")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  articleProducts ArticleProduct[]
  comments        Comment[]
  collects        Collect[]

  @@map("articles")
}

model ArticleProduct {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  productId String   @map("product_id")
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([articleId, productId])
  @@map("article_products")
}

model Comment {
  id            String   @id @default(uuid())
  articleId     String   @map("article_id")
  userId        String   @map("user_id")
  parentId      String?  @map("parent_id")
  replyToUserId String?  @map("reply_to_user_id")
  content       String   @db.Text
  likeCount     Int      @default(0) @map("like_count")
  status        String   @default("published") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  article Article   @relation(fields: [articleId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Like {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@map("likes")
}

model Collect {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@map("collects")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("FollowerRelation", fields: [followerId], references: [id])
  following User @relation("FollowingRelation", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@map("follows")
}

// ================================================================
// 第三组：动画内容与商品（5张表）
// ================================================================

model Animation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String   @db.VarChar(200)
  description   String?  @db.Text
  previewUrl    String?  @map("preview_url") @db.VarChar(500)
  frameCount    Int      @map("frame_count")
  copyrightType String   @map("copyright_type") @db.VarChar(20)
  copyrightNote String?  @map("copyright_note") @db.Text
  status        String   @default("draft") @db.VarChar(20)
  fileHash      String?  @map("file_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  frames   AnimationFrame[]
  products Product[]

  @@map("animations")
}

model AnimationFrame {
  id          String   @id @default(uuid())
  animationId String   @map("animation_id")
  frameIndex  Int      @map("frame_index")
  imageUrl    String   @map("image_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  animation Animation @relation(fields: [animationId], references: [id])

  @@unique([animationId, frameIndex])
  @@map("animation_frames")
}

model Product {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  animationId    String   @map("animation_id")
  crmebProductId String?  @map("crmeb_product_id") @db.VarChar(100)
  title          String   @db.VarChar(200)
  description    String?  @db.Text
  machineType    String   @map("machine_type") @db.VarChar(20)
  frameCount     Int      @map("frame_count")
  basePrice      Decimal  @map("base_price") @db.Decimal(10, 2)
  markupPrice    Decimal  @map("markup_price") @db.Decimal(10, 2)
  finalPrice     Decimal  @map("final_price") @db.Decimal(10, 2)
  stockType      String   @default("unlimited") @map("stock_type") @db.VarChar(20)
  stockLimit     Int?     @map("stock_limit")
  status         String   @default("pending") @db.VarChar(20)
  rejectReason   String?  @map("reject_reason") @db.VarChar(500)
  salesCount     Int      @default(0) @map("sales_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  animation       Animation        @relation(fields: [animationId], references: [id])
  articleProducts ArticleProduct[]
  orderExts       OrderExt[]
  earnings        Earning[]

  @@map("products")
}

model OrderExt {
  id               String   @id @default(uuid())
  crmebOrderId     String   @map("crmeb_order_id") @db.VarChar(100)
  productId        String   @map("product_id")
  animationId      String   @map("animation_id")
  buyerId          String   @map("buyer_id")
  creatorId        String   @map("creator_id")
  finalPrice       Decimal  @map("final_price") @db.Decimal(10, 2)
  platformFeeRate  Decimal  @map("platform_fee_rate") @db.Decimal(5, 2)
  platformFee      Decimal  @map("platform_fee") @db.Decimal(10, 2)
  creatorIncome    Decimal  @map("creator_income") @db.Decimal(10, 2)
  productionStatus String   @default("waiting") @map("production_status") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("orders_ext")
}

model PlatformRule {
  id          String   @id @default(uuid())
  ruleKey     String   @unique @map("rule_key") @db.VarChar(50)
  ruleValue   Decimal  @map("rule_value") @db.Decimal(10, 2)
  description String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_rules")
}

// ================================================================
// 第四组：收益与提现（3张表）
// ================================================================

model Earning {
  id              String    @id @default(uuid())
  creatorId       String    @map("creator_id")
  orderExtId      String    @map("order_ext_id")
  productId       String    @map("product_id")
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(10, 2)
  platformFeeRate Decimal   @map("platform_fee_rate") @db.Decimal(5, 2)
  platformFee     Decimal   @map("platform_fee") @db.Decimal(10, 2)
  netAmount       Decimal   @map("net_amount") @db.Decimal(10, 2)
  status          String    @default("pending") @db.VarChar(20)
  // pending待结算 / available可提现 / withdrawn已提现
  availableAt     DateTime? @map("available_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  creator User    @relation(fields: [creatorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("earnings")
}

model Balance {
  id              String   @id @default(uuid())
  creatorId       String   @unique @map("creator_id")
  pendingAmount   Decimal  @default(0) @map("pending_amount") @db.Decimal(10, 2)
  availableAmount Decimal  @default(0) @map("available_amount") @db.Decimal(10, 2)
  withdrawnAmount Decimal  @default(0) @map("withdrawn_amount") @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@map("balances")
}

model WithdrawalRequest {
  id            String    @id @default(uuid())
  creatorId     String    @map("creator_id")
  amount        Decimal   @db.Decimal(10, 2)
  method        String    @db.VarChar(20) // alipay / bankcard
  accountName   String    @map("account_name") @db.VarChar(50)
  accountNumber String    @map("account_number") @db.VarChar(100)
  bankName      String?   @map("bank_name") @db.VarChar(100)
  // 灵活用工平台占位字段（阶段1先存记录，API后续接入）
  flexTaskId    String?   @map("flex_task_id") @db.VarChar(100)
  flexStatus    String?   @map("flex_status") @db.VarChar(20)
  status        String    @default("pending") @db.VarChar(20)
  // pending / processing / paid / rejected / failed
  rejectReason  String?   @map("reject_reason") @db.VarChar(500)
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@map("withdrawal_requests")
}

// ================================================================
// 第五组：机型与定制订单
// ================================================================

model MachineModel {
  id           String   @id @default(uuid())
  name         String
  description  String?
  ratios       String
  frameOptions String
  sizes        String
  previewImage String?
  videoUrl     String?  @map("video_url") @db.VarChar(500)
  modelType    String   @default("single") @map("model_type")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skus MachineModelSku[]

  @@map("machine_models")
}

model MachineModelSku {
  id           String  @id @default(uuid())
  modelId      String  @map("model_id")
  size         String  @db.VarChar(20)
  material     String  @db.VarChar(50)
  frameCount   Int     @map("frame_count")
  colorName    String  @map("color_name") @db.VarChar(50)
  colorHex     String  @map("color_hex") @db.VarChar(10)
  previewImage String? @map("preview_image") @db.VarChar(500)
  price        Decimal @default(0) @db.Decimal(10, 2)
  skuBarcode   String? @map("sku_barcode") @db.VarChar(50)
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  exampleMedia String? @map("example_media") // JSON: ["oss/path1", "oss/path2"]

  // v2 新增：结构化编码与授权字段
  skuCode           String?   @map("sku_code") @db.VarChar(50) // 如 STD-55-12F-WD-NA
  skuType           String    @default("KIT") @map("sku_type") @db.VarChar(20) // KIT / CBR_TEMPLATE / MTO_TEMPLATE
  licenseExpireDate DateTime? @map("license_expire_date") // CBR授权到期日
  licenseStatus     String?   @default("Active") @map("license_status") @db.VarChar(20) // Active / Expiring / Expired
  bomVersion        Int       @default(0) @map("bom_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  model        MachineModel  @relation(fields: [modelId], references: [id])
  printCutRule PrintCutRule?

  @@unique([modelId, size, material, frameCount, colorName])
  @@map("machine_model_skus")
}

// 帧素材共用的打印与裁切方式，不按商品款式拆分。
model PrintCutGroup {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(40)
  name             String   @db.VarChar(80)
  size             String   @db.VarChar(20)
  paperSize        String   @default("A4") @map("paper_size") @db.VarChar(20)
  paperType        String   @default("普通打印纸") @map("paper_type") @db.VarChar(40)
  orientation      String   @default("LANDSCAPE") @db.VarChar(20)
  frameWidthMm     Int?     @map("frame_width_mm")
  frameHeightMm    Int?     @map("frame_height_mm")
  framesPerSheet   Int      @map("frames_per_sheet")
  renderDpi        Int      @default(600) @map("render_dpi")
  separatorMicrons Int      @default(460) @map("separator_microns")
  cuttingTool      String?  @map("cutting_tool") @db.VarChar(80)
  templateKey      String?  @map("template_key") @db.VarChar(120)
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  rules     PrintCutRule[]
  templates PrintTemplateVersion[]

  @@index([isActive, sortOrder])
  @@map("print_cut_groups")
}

// Word 排版模板不可覆盖；换模板必须新增版本，历史生产文件继续指向旧版本。
model PrintTemplateVersion {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  versionNo    Int      @map("version_no")
  originalName String   @map("original_name") @db.VarChar(255)
  objectKey    String   @unique @map("object_key") @db.VarChar(500)
  sha256       String   @db.VarChar(64)
  sizeBytes    Int      @map("size_bytes")
  cellCount    Int      @map("cell_count")
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  group PrintCutGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  files ProductionPrintFile[]

  @@unique([groupId, versionNo])
  @@index([groupId, status, versionNo])
  @@map("print_template_versions")
}

// 一个真实 SKU 只能归入一个打印裁切组，避免生产时出现两种执行方式。
model PrintCutRule {
  id               String   @id @default(uuid())
  groupId          String   @map("group_id")
  skuId            String?  @unique @map("sku_id")
  legacySize       String?  @map("size") @db.VarChar(20)
  legacyFrameCount Int?     @map("frame_count")
  pagesPerUnit     Int      @map("pages_per_unit")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  group PrintCutGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sku   MachineModelSku? @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([groupId, isActive, sortOrder])
  @@map("print_cut_rules")
}

model CustomizeOrder {
  id                 String    @id @default(uuid())
  orderNo            String    @unique
  userId             String    @map("user_id")
  modelId            String    @map("model_id")
  modelName          String    @map("model_name")
  frameCount         Int       @map("frame_count")
  size               String
  material           String
  color              String
  colorName          String    @map("color_name")
  skuId              String    @map("sku_id")
  ossPath            String    @map("oss_path")
  frameUrls          String    @map("frame_urls") // JSON数组
  status             String    @default("pending")
  // pending→paid→locked→processing→producing→shipped→received→aftersale/cancelled
  inventoryStatus    String    @default("normal") @map("inventory_status") @db.VarChar(20)
  sourceType         String    @default("custom") @map("source_type")
  collabWorkId       String?   @map("collab_work_id")
  crmebOrderId       String?   @map("crmeb_order_id")
  assignedTo         String?   @map("assigned_to")
  receiverName       String?   @map("receiver_name")
  receiverPhone      String?   @map("receiver_phone")
  receiverAddress    String?   @map("receiver_address")
  receiverCity       String?   @map("receiver_city")
  trackingNo         String?   @map("tracking_no")
  trackingCompany    String?   @map("tracking_company")
  shippedAt          DateTime? @map("shipped_at")
  receivedAt         DateTime? @map("received_at")
  aftersaleCount     Int       @default(0) @map("aftersale_count") // 售后申请次数（防刷上限3次）
  batchId            String?   @map("batch_id")
  seqNo              Int?      @map("seq_no")
  salesOrderItemId   String?   @map("sales_order_item_id")
  unitIndex          Int?      @map("unit_index")
  replacementForId   String?   @map("replacement_for_id")
  aftersaleRequestId String?   @map("aftersale_request_id")

  // v2 新增：多平台来源 + 锁单机制
  platform        String  @default("SELF") @map("platform") @db.VarChar(20)
  // SELF / TAOBAO / DOUYIN / XHS
  externalOrderId String? @map("external_order_id") @db.VarChar(100) // 原平台订单号
  lockStatus      String  @default("UNLOCKED") @map("lock_status") @db.VarChar(20)
  // UNLOCKED / LOCKED（加入批次后禁止修改SKU/规格/数量）
  priorityLevel   Int     @default(0) @map("priority_level") // 迭代预留：0=普通/1=加急/2=KOL
  buyerNote       String? @map("buyer_note") @db.VarChar(500)
  importStatus    String? @map("import_status") @db.VarChar(20)
  // pending_info（待补全收件信息）/ pending_sku（SKU待确认）/ null=正常

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id])
  aftersaleRequests AftersaleRequest[]
  salesOrderItem    SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)

  @@unique([platform, externalOrderId], name: "platform_external_order_unique")
  @@unique([salesOrderItemId, unitIndex])
  @@index([salesOrderItemId])
  @@index([replacementForId])
  @@index([aftersaleRequestId])
  @@map("customize_orders")
}

// ================================================================
// 第五点五组：售后申请
// ================================================================

model AftersaleRequest {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  userId      String    @map("user_id")
  type        String    @db.VarChar(20) // refund（退款申请）| quality（质量售后）
  reason      String    @db.VarChar(100) // 原因文字，从预定义列表选
  description String?   @db.Text // 用户补充说明（可选）
  imageUrls   String    @default("[]") @map("image_urls") // JSON数组，OSS objectKey
  status      String    @default("pending") @db.VarChar(20)
  // pending | approved | rejected | completed | cancelled
  adminNote   String?   @map("admin_note") @db.Text // 管理员处理回复
  adminId     String?   @map("admin_id")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order CustomizeOrder @relation(fields: [orderId], references: [id])
  user  User           @relation(fields: [userId], references: [id])

  @@map("aftersale_requests")
}

// ================================================================
// 第六组：联名体系
// ================================================================

model CollabWork {
  id                 String    @id @default(uuid())
  creatorId          String    @map("creator_id")
  orderNo            String?   @map("order_no") // 可选：动画直接提交时为 null
  title              String
  description        String?
  coverUrl           String?   @map("cover_url")
  animationFrames    String    @map("animation_frames") // JSON数组 OSS objectKey
  supportedSkus      String    @map("supported_skus") // JSON数组 SKU ID
  sizes              String?   @db.Text // JSON数组 如["5x5cm","8x8cm"]
  framePackOssPath   String?   @map("frame_pack_oss_path") @db.VarChar(500)
  isNewbieWork       Boolean   @default(false) @map("is_newbie_work")
  newbieExpiredAt    DateTime? @map("newbie_expired_at") // 审核通过后 +30天
  activityId         String?   @map("activity_id")
  isExclusiveWork    Boolean   @default(false) @map("is_exclusive_work")
  status             String    @default("pending")
  // pending / approved / rejected
  rejectReason       String?   @map("reject_reason")
  agreementSignedAt  DateTime  @map("agreement_signed_at")
  approvedAt         DateTime? @map("approved_at")
  approvedBy         String?   @map("approved_by")
  revenueRate        Float     @default(0) @map("revenue_rate") // 审核时快照
  isOnShelf          Boolean   @default(false) @map("is_on_shelf")
  shelfAt            DateTime? @map("shelf_at")
  shelfStatus        String    @default("on_sale") @map("shelf_status")
  // on_sale / suspended / pending_delist / off_shelf
  suspendedAt        DateTime? @map("suspended_at")
  suspendedBy        String?   @map("suspended_by")
  offShelfAt         DateTime? @map("off_shelf_at")
  offShelfType       String?   @map("off_shelf_type") // platform_force / creator_request
  offShelfReason     String?   @map("off_shelf_reason") @db.Text // 内部备注
  offShelfNotice     String?   @map("off_shelf_notice") @db.Text // 发给创作者的通知
  canResubmit        Boolean   @default(false) @map("can_resubmit")
  delistRequestedAt  DateTime? @map("delist_requested_at")
  delistReason       String?   @map("delist_reason") @db.Text
  submissionBatchId  String?   @map("submission_batch_id") // 同批次提交的作品共享同一 batchId
  isRevision         Boolean   @default(false) @map("is_revision") // 是否为修改版
  originalWorkId     String?   @map("original_work_id") // 指向被修改的原作品 ID
  changeLog          String?   @map("change_log") @db.Text // JSON diff: {title:{old,new},...}
  hoverGifUrl        String?   @map("hover_gif_url") // 卡片 hover 用小 GIF OSS 路径
  creatorMarkups     String?   @map("creator_markups") // JSON: {"skuId": decimalAmount}
  animationAssetId   String?   @map("animation_asset_id")
  animationVersionId String?   @map("animation_version_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  framePacks       CollabFramePack[]
  collabOrders     CollabOrder[]
  animationAsset   AnimationAsset?        @relation(fields: [animationAssetId], references: [id], onDelete: SetNull)
  animationVersion AnimationAssetVersion? @relation(fields: [animationVersionId], references: [id], onDelete: SetNull)

  @@index([submissionBatchId])
  @@index([originalWorkId])
  @@index([animationAssetId])
  @@index([animationVersionId])
  @@map("collab_works")
}

model CollabOrder {
  id           String @id @default(uuid())
  orderId      String @map("order_id") // 关联 customize_orders.id
  collabWorkId String @map("collab_work_id")
  creatorId    String @map("creator_id")

  salePrice     Float @map("sale_price") // 成交价快照
  revenueRate   Float @map("revenue_rate") // 分红率快照
  revenueAmount Float @map("revenue_amount") // 应付分红 = salePrice × revenueRate

  // 储备金（初期固定15%）
  reserveRate   Float @default(0.15) @map("reserve_rate")
  reserveAmount Float @default(0) @map("reserve_amount") // revenueAmount × reserveRate
  payoutAmount  Float @default(0) @map("payout_amount") // revenueAmount - reserveAmount

  // 分红状态机
  revenueStatus String    @default("estimated") @map("revenue_status") @db.VarChar(20)
  // estimated=预估(未收货) / cooling=冷却中(已收货,等15天) / available=可提现 / withdrawn=已提现
  coolingEndAt  DateTime? @map("cooling_end_at") // 收货确认时间 + 15天

  // 结算（管理端打款用）
  settlementStatus String    @default("pending") @map("settlement_status") @db.VarChar(20)
  // pending / settled
  settlementWeek   String?   @map("settlement_week") @db.VarChar(10) // 如 2026-W14
  settledAt        DateTime? @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")

  collabWork  CollabWork   @relation(fields: [collabWorkId], references: [id])
  reserveLogs ReserveLog[]

  @@map("collab_orders")
}

model CollabActivity {
  id          String   @id @default(uuid())
  name        String
  description String?
  revenueRate Float    @map("revenue_rate")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("collab_activities")
}

model CollabFramePack {
  id             String   @id @default(uuid())
  collabWorkId   String   @map("collab_work_id")
  size           String   @db.VarChar(20)
  ossPath        String?  @map("oss_path") @db.VarChar(500)
  localCachePath String?  @map("local_cache_path") @db.VarChar(500)
  stockType      String   @default("on_demand") @map("stock_type") @db.VarChar(20)
  currentStock   Int      @default(0) @map("current_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  collabWork CollabWork @relation(fields: [collabWorkId], references: [id])

  @@unique([collabWorkId, size])
  @@map("collab_frame_packs")
}

// ================================================================
// 第六组（续）：帧包备货白名单
// ================================================================

model FramePackWork {
  id           String             @id @default(uuid())
  collabWorkId String?            @unique @map("collab_work_id")
  name         String             @db.VarChar(200)
  thumbnailKey String?            @map("thumbnail_key") @db.VarChar(500)
  isActive     Boolean            @default(true) @map("is_active")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  variants     FramePackVariant[]

  @@map("frame_pack_works")
}

model FramePackVariant {
  id           String         @id @default(uuid())
  workId       String         @map("work_id")
  size         String         @db.VarChar(20)
  frameCount   Int            @map("frame_count")
  skuCode      String?        @map("sku_code") @db.VarChar(50)
