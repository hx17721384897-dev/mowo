// 第七组：库存与生产
// ================================================================

model SkuInventory {
  id            String @id @default(uuid())
  skuId         String @unique @map("sku_id")
  currentStock  Int    @default(0) @map("current_stock") // 等同 total_qty
  serviceStock  Int    @default(0) @map("service_stock")
  reservedStock Int    @default(0) @map("reserved_stock") // 等同 locked_qty（已下单待生产）
  safetyStock   Int    @default(10) @map("safety_stock")
  maxOrderLimit Int    @default(100) @map("max_order_limit")

  // v2 新增：4态库存（available = currentStock - reservedStock - wipFrameQty - wipKitQty）
  wipFrameQty  Int    @default(0) @map("wip_frame_qty") // 帧图在制，不可回流
  wipKitQty    Int    @default(0) @map("wip_kit_qty") // 材料包在制，取消可归还
  warehouseId  String @default("1") @map("warehouse_id")
  finishedQty  Int    @default(0) @map("finished_qty") // 迭代预留，初期为0
  safetyFactor Float  @default(1.0) @map("safety_factor") // 流量因子，发视频前调至2.0

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sku_inventory")
}

model InventoryLog {
  id         String  @id @default(uuid())
  skuId      String  @map("sku_id")
  // in / out / reserved / released（旧）
  // wip_frame_start / wip_kit_start / wip_kit_rollback / wip_defect_frame / wip_deduct / manual_adjustment（新）
  type       String  @db.VarChar(30)
  quantity   Int
  orderId    String? @map("order_id")
  operatorId String? @map("operator_id")
  note       String? @db.VarChar(200)

  // v2 新增
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(100)
  beforeQty      Int?    @map("before_qty") // 操作前 available_qty
  afterQty       Int?    @map("after_qty") // 操作后 available_qty
  reason         String? @db.VarChar(200) // manual_adjustment 时必填

  createdAt DateTime @default(now()) @map("created_at")

  @@index([skuId])
  @@index([orderId])
  @@map("inventory_logs")
}

model AuthCode {
  id            String    @id @default(uuid())
  code          String    @unique @db.VarChar(20)
  orderId       String    @map("order_id")
  skuId         String    @map("sku_id")
  issuedAt      DateTime  @map("issued_at")
  queriedCount  Int       @default(0) @map("queried_count")
  lastQueriedAt DateTime? @map("last_queried_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("auth_codes")
}

model ShippingBatch {
  id              String   @id @default(uuid())
  trackingNo      String?  @map("tracking_no")
  trackingCompany String?  @map("tracking_company")
  receiverName    String   @map("receiver_name")
  receiverPhone   String   @map("receiver_phone")
  receiverAddress String   @map("receiver_address")
  receiverCity    String   @map("receiver_city")
  status          String   @default("pending")
  orderCount      Int      @default(0) @map("order_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shipping_batches")
}

// ================================================================
// 库存系统 v2 新增（7张表）
// ================================================================

// 平台规格文本 → 内部 sku_code 映射
model PlatformSkuMapping {
  id              String   @id @default(uuid())
  platform        String   @db.VarChar(10) // TB / DY / XHS
  externalDesc    String   @map("external_desc") @db.Text
  internalSkuCode String   @map("internal_sku_code") @db.VarChar(50) // 映射到 machine_model_skus.sku_code
  collabWorkId    String?  @map("collab_work_id") // null = 普通定制款；有值 = 联名款，映射到 collab_works.id
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([platform])
  @@map("platform_sku_mappings")
}

// 生产批次主表（新批次号格式：PB-YYYYMMDD-XXXXXX；旧编号继续只读兼容）
model ProductionBatch {
  id                  String   @id // 例：20260414_143022
  operatorId          String   @map("operator_id")
  status              String   @default("READY") @db.VarChar(20)
  // READY / IN_PROGRESS / COMPLETED / ARCHIVED；旧值继续只读兼容
  maxCapacity         Int?     @map("max_capacity") // 迭代预留，初期 NULL 不限制
  warningSnapshot     Json?    @map("warning_snapshot")
  salesOrderCount     Int      @default(0) @map("sales_order_count")
  productionUnitCount Int      @default(0) @map("production_unit_count")
  skuCount            Int      @default(0) @map("sku_count")
  printPlanSnapshot   Json?    @map("print_plan_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  batchItems BatchItem[]
  orders     ProductionBatchOrder[]
  units      ProductionBatchUnit[]

  @@map("production_batches")
}

// 正式生产批次与用户总订单的冻结关系。一个总订单必须整体加入批次。
model ProductionBatchOrder {
  id              String   @id @default(uuid())
  batchId         String   @map("batch_id")
  salesOrderId    String   @map("sales_order_id")
  orderNoSnapshot String   @map("order_no_snapshot") @db.VarChar(40)
  status          String   @default("WAITING") @db.VarChar(20)
  warningSnapshot Json?    @map("warning_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")

  batch      ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@unique([batchId, salesOrderId])
  @@index([salesOrderId, status])
  @@map("production_batch_orders")
}

// 批次中的单件生产任务，并行记录帧包、领料、配对和打包四条进度。
model ProductionBatchUnit {
  id                   String   @id @default(uuid())
  batchId              String   @map("batch_id")
  productionUnitId     String   @map("production_unit_id")
  salesOrderId         String   @map("sales_order_id")
  skuId                String   @map("sku_id")
  productionNoSnapshot String   @map("production_no_snapshot") @db.VarChar(40)
  printGroupId         String?  @map("print_group_id")
  printGroupCode       String?  @map("print_group_code") @db.VarChar(40)
  printGroupName       String?  @map("print_group_name") @db.VarChar(80)
  printRuleId          String?  @map("print_rule_id")
  printSequence        Int?     @map("print_sequence")
  printPageCount       Int?     @map("print_page_count")
  printRuleSnapshot    Json?    @map("print_rule_snapshot")
  frameStatus          String   @default("WAITING") @map("frame_status") @db.VarChar(20)
  materialStatus       String   @default("WAITING") @map("material_status") @db.VarChar(20)
  pairingStatus        String   @default("WAITING") @map("pairing_status") @db.VarChar(20)
  packageStatus        String   @default("WAITING") @map("package_status") @db.VarChar(20)
  exceptionStatus      String   @default("NORMAL") @map("exception_status") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, productionUnitId])
  @@index([productionUnitId])
  @@index([batchId, skuId])
  @@index([batchId, printSequence])
  @@index([salesOrderId, packageStatus])
  @@map("production_batch_units")
}

// 批次内各 SKU 计划/实产/报废聚合（生产看板数据源）
model BatchItem {
  id         String  @id @default(uuid())
  batchId    String  @map("batch_id")
  skuId      String  @map("sku_id") // 关联 machine_model_skus.id
  skuCode    String? @map("sku_code") @db.VarChar(50) // 冗余存 sku_code，方便展示
  plannedQty Int     @default(0) @map("planned_qty") // 批次导出时计算
  actualQty  Int     @default(0) @map("actual_qty") // 扫码配对成功时 +1
  defectQty  Int     @default(0) @map("defect_qty") // 点击「报废重制」时 +1

  batch ProductionBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, skuId])
  @@index([batchId])
  @@map("batch_items")
}

// 定制款帧图实例（MTO 订单专用）
// content_hash 在生成打印文件时计算冻结，生产端始终按此版本执行
model FrameInstance {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  templateSkuCode String   @map("template_sku_code") @db.VarChar(50)
  imageUrl        String?  @map("image_url") @db.Text // 用户上传原始图片 OSS 路径
  printFileUrl    String?  @map("print_file_url") @db.Text // 拼版后 PDF 打印文件路径
  contentHash     String?  @map("content_hash") @db.VarChar(64) // SHA-256，生产文件生成时写入
  status          String   @default("Draft") @db.VarChar(20)
  // Draft（用户可修改）/ Locked（生产文件已生成，禁止修改）
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("frame_instances")
}

// 每日库存全量快照（财务级审计基准）
model InventorySnapshot {
  id           String   @id @default(uuid())
  skuId        String   @map("sku_id")
  totalQty     Int      @map("total_qty")
  availableQty Int      @map("available_qty")
  lockedQty    Int      @map("locked_qty")
  wipFrameQty  Int      @map("wip_frame_qty")
  wipKitQty    Int      @map("wip_kit_qty")
  unitCost     Decimal? @map("unit_cost") @db.Decimal(10, 2) // 迭代预留：加权平均单位成本
  snapshotDate DateTime @map("snapshot_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([skuId, snapshotDate])
  @@index([snapshotDate])
  @@map("inventory_snapshots")
}

// 扫码配对绑定记录（配对绑定 + 合单分拣双用途）
model OrderItemBinding {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  trackingNo      String?  @map("tracking_no")
  source          String   @db.VarChar(20) // SELF / TAOBAO / DOUYIN / XHS
  externalOrderId String?  @map("external_order_id") @db.VarChar(100)
  frameCode       String?  @map("frame_code") @db.VarChar(100) // 帧包码（条形码）
  kitSkuId        String?  @map("kit_sku_id") // 材料包 SKU ID
  batchId         String?  @map("batch_id") // 所属生产批次
  status          String   @default("Pending") @db.VarChar(20)
  // Pending / Bound / Shipped
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([batchId])
  @@map("order_item_bindings")
}

// 渠道配额配置（每 SKU 一条，运营手动设置后同步至各平台后台）
model ChannelQuota {
  id             String   @id @default(uuid())
  skuId          String   @unique @map("sku_id")
  bufferPool     Int      @default(10) @map("buffer_pool") // 负向缓冲池（实际可分配 = available - bufferPool）
  taobaoQty      Int      @default(0) @map("taobao_qty") // 淘宝展示配额（绝对数）
  douyinQty      Int      @default(0) @map("douyin_qty") // 抖音展示配额
  xhsQty         Int      @default(0) @map("xhs_qty") // 小红书展示配额
  livestreamMode Boolean  @default(false) @map("livestream_mode") // 开启时抖音配额临时扩至60%
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("channel_quotas")
}

model OperationLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  userRole   Int      @map("user_role")
  action     String?
  method     String
  path       String
  target     String?
  targetId   String?  @map("target_id")
  before     String?  @db.Text
  after      String?  @db.Text
  ip         String?
  outcome    String   @default("SUCCESS") @db.VarChar(20)
  statusCode Int?     @map("status_code")
  sessionId  String?  @map("session_id") @db.VarChar(100)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([outcome, createdAt])
  @@index([userId, createdAt])
  @@map("operation_logs")
}

// ================================================================
// 第八组：联络表单
// ================================================================

model ContactSubmission {
  id              String    @id @default(uuid())
  type            String    @db.VarChar(20)
  // artist / channel / media / join / feedback / factory
  name            String
  contact         String
  message         String    @db.Text
  extra           String?   @db.Text
  attachments     String?
  submitterUserId String?   @map("submitter_user_id")
  ip              String?
  userAgent       String?   @map("user_agent") @db.Text
  status          String    @default("pending") @db.VarChar(20)
  // pending / processing / done / spam
  isStarred       Boolean   @default(false) @map("is_starred")
  handledBy       String?   @map("handled_by")
  handledAt       DateTime? @map("handled_at")
  note            String?   @db.Text
  spamScore       Int       @default(0) @map("spam_score")
  isBlocked       Boolean   @default(false) @map("is_blocked")
