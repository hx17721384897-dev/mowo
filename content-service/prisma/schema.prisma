// ================================================================
// 第九组：创作者分红结算体系（3张表）
// ================================================================

// 创作者储备金账户，一人一条，实时余额快照
model CreatorReserve {
  id        String @id @default(uuid())
  creatorId String @unique @map("creator_id")

  totalReserved    Float @default(0) @map("total_reserved") // 累计扣入储备金总额
  frozenAmount     Float @default(0) @map("frozen_amount") // 当前违规冻结中
  releasableAmount Float @default(0) @map("releasable_amount") // 90天期内待释放
  releasedAmount   Float @default(0) @map("released_amount") // 已释放回余额累计

  nextReleaseAt     DateTime? @map("next_release_at") // 最近一批解冻时间
  nextReleaseAmount Float     @default(0) @map("next_release_amount") // 最近一批待释放金额

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  creator User         @relation(fields: [creatorId], references: [id])
  logs    ReserveLog[]

  @@map("creator_reserves")
}

// 储备金每一笔变动流水，完整可溯源
model ReserveLog {
  id            String  @id @default(uuid())
  creatorId     String  @map("creator_id")
  reserveId     String  @map("reserve_id") // 关联 creator_reserves.id
  collabOrderId String? @map("collab_order_id") // 扣入时关联的联名订单

  actionType String @map("action_type") @db.VarChar(20)
  // deduct=扣入 / release=90天释放 / freeze=违规冻结 / unfreeze=解冻 / confiscate=没收

  amount       Float // 本次变动金额（正数）
  balanceAfter Float     @map("balance_after") // 变动后储备金余额
  releaseAt    DateTime? @map("release_at") // 预计释放时间（deduct时 = 收货确认+90天）
  note         String?   @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")

  creator     User           @relation(fields: [creatorId], references: [id])
  reserve     CreatorReserve @relation(fields: [reserveId], references: [id])
  collabOrder CollabOrder?   @relation(fields: [collabOrderId], references: [id])

  @@index([creatorId])
  @@index([reserveId])
  @@index([releaseAt]) // 定时任务按此字段扫描到期释放
  @@map("reserve_logs")
}

// 管理员每次确认打款的凭证
model SettlementRecord {
  id             String @id @default(uuid())
  settlementWeek String @map("settlement_week") @db.VarChar(10) // 如 2026-W14

  creatorId       String @map("creator_id")
  orderCount      Int    @map("order_count")
  totalRevenue    Float  @map("total_revenue") // 分红合计
  reserveDeducted Float  @map("reserve_deducted") // 本批储备金扣除合计
  payoutAmount    Float  @map("payout_amount") // 实际打入余额

  status String @default("pending") @db.VarChar(20)
  // pending=待打款 / paid=已打款 / failed=失败

  settledBy String?   @map("settled_by") // 操作管理员 userId
  settledAt DateTime? @map("settled_at")
  note      String?   @db.VarChar(500) // 如灵活用工平台任务单号

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator       User  @relation(fields: [creatorId], references: [id])
  settledByUser User? @relation("SettlementAdmin", fields: [settledBy], references: [id])

  @@unique([settlementWeek, creatorId]) // 同一周同一创作者只有一条
  @@index([settlementWeek])
  @@index([creatorId])
  @@map("settlement_records")
}

// ================================================================
// 第十组：牛量系统（5张表）
// ================================================================

// 平台可调参数配置，管理后台可修改，批处理读取
// 所有牛量等级阈值、权重、分红参数都存这里，不写死在代码里
model PlatformConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique @map("config_key") @db.VarChar(100)
  configValue String   @map("config_value") @db.VarChar(500) // 统一存字符串，读取时按需转换
  valueType   String   @default("number") @map("value_type") @db.VarChar(20)
  // number / string / json
  description String?  @db.VarChar(200)
  groupName   String   @default("bull") @map("group_name") @db.VarChar(50)
  // bull=牛量参数 / revenue=分红参数 / system=系统参数
  updatedBy   String?  @map("updated_by") // 最后修改的管理员 userId
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  updater User? @relation("ConfigUpdater", fields: [updatedBy], references: [id])

  @@index([groupName])
  @@map("platform_configs")
}

// 创作者每日牛量积分快照，批处理每天写一条
model BullScore {
  id        String @id @default(uuid())
  creatorId String @map("creator_id")

  // 三维度原始分（0~100）
  activityScore   Float @default(0) @map("activity_score") // 活跃贡献度得分
  socialScore     Float @default(0) @map("social_score") // 外部声量得分
  conversionScore Float @default(0) @map("conversion_score") // 销售转化得分

  // 加权合成总分（activity×0.2 + social×0.3 + conversion×0.5）
  totalScore Float @default(0) @map("total_score")

  // 各维度原始数据快照（方便回溯和展示）
  monthlyPosts    Int   @default(0) @map("monthly_posts") // 近30天上传数
  monthlyOrders   Int   @default(0) @map("monthly_orders") // 近30天订单数
  totalViews      Int   @default(0) @map("total_views") // 外部累计播放量
  totalLikes      Int   @default(0) @map("total_likes") // 外部累计点赞数
  socialManualMod Float @default(1.0) @map("social_manual_mod") // 管理员人工系数（0.5~2.0）

  scoreDate DateTime @map("score_date") @db.Date // 计算日期（每天一条）
  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@unique([creatorId, scoreDate]) // 每人每天只有一条
  @@index([creatorId])
  @@index([scoreDate])
  @@map("bull_scores")
}

// 牛量等级变动记录，升级/降级/手动调整都记一条，创作者可查看原因
model BullScoreLog {
  id        String @id @default(uuid())
  creatorId String @map("creator_id")

  changeType String @map("change_type") @db.VarChar(20)
  // upgrade=升级 / downgrade=降级 / manual=管理员手动调整 / init=初始化

  levelBefore Int   @map("level_before") // 变动前等级 1~5
  levelAfter  Int   @map("level_after") // 变动后等级 1~5
  scoreBefore Float @map("score_before")
  scoreAfter  Float @map("score_after")

  reason     String? @db.VarChar(200) // 变动原因描述，如「连续2个月未达标」
  operatorId String? @map("operator_id") // 手动调整时的管理员 userId

  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([createdAt])
  @@map("bull_score_logs")
}

// 创作者专属推广链接，用于销售转化维度归因
model CreatorReferralLink {
  id        String @id @default(uuid())
  creatorId String @unique @map("creator_id")

  linkCode String @unique @map("link_code") @db.VarChar(20)
  // 如 ref_abc123，拼接成 mowobox.com?ref=abc123

  totalClicks  Int   @default(0) @map("total_clicks") // 累计点击次数
  totalOrders  Int   @default(0) @map("total_orders") // 累计带来的订单数
  totalRevenue Float @default(0) @map("total_revenue") // 累计带来的销售额

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User            @relation(fields: [creatorId], references: [id])
  clicks  ReferralClick[]

  @@map("creator_referral_links")
}

// 推广链接点击记录，用于追踪归因
model ReferralClick {
  id        String @id @default(uuid())
  linkId    String @map("link_id")
  creatorId String @map("creator_id") // 冗余，方便查询

  ip        String? @db.VarChar(50)
  userAgent String? @map("user_agent") @db.Text
  referrer  String? @db.VarChar(500) // 来源页（B站/小红书等）
  orderId   String? @map("order_id") // 如果该次点击最终产生了订单，记录订单ID

  createdAt DateTime @default(now()) @map("created_at")

  link CreatorReferralLink @relation(fields: [linkId], references: [id])

  @@index([linkId])
  @@index([creatorId])
  @@index([createdAt])
  @@map("referral_clicks")
}

// ================================================================
// 第十一组：引流链接 + 大IP商务合同（2张表）
// ================================================================

// 创作者填写的外部平台视频链接，用于声量维度计算
model CreatorSocialLink {
  id        String @id @default(uuid())
  creatorId String @map("creator_id")

  platform String @db.VarChar(20)
  // bilibili / xiaohongshu / weibo / douyin / other

  videoUrl    String  @map("video_url") @db.VarChar(500) // 视频链接
  videoTitle  String? @map("video_title") @db.VarChar(200) // 视频标题（创作者填写）
  description String? @db.Text // 创作者说明

  // 爬取到的数据（初期由管理员手动填，后期爬虫自动更新）
  viewCount     Int       @default(0) @map("view_count")
  likeCount     Int       @default(0) @map("like_count")
  lastFetchedAt DateTime? @map("last_fetched_at")

  // 审核
  status String @default("pending") @map("status") @db.VarChar(20)
  // pending=待审核 / approved=通过 / rejected=不符合要求

  brandMentioned Boolean   @default(false) @map("brand_mentioned") // 是否提及品牌
  manualMod      Float     @default(1.0) @map("manual_mod") // 声量加成系数 0.5~2.0
  reviewNote     String?   @map("review_note") @db.VarChar(200) // 审核备注
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([status])
  @@map("creator_social_links")
}

// 大IP / 商务合作合同记录
// 这类合作不走平台标准分红体系，由商务单独谈定后在此录入
model CreatorContract {
  id          String @id @default(uuid())
  creatorId   String @map("creator_id") // 关联平台账号（可选，有些IP方可能没有创作者账号）
  creatorName String @map("creator_name") @db.VarChar(100) // 合作方名称（冗余，防止账号不存在）

  contractType String @map("contract_type") @db.VarChar(20)
  // revenue_share=纯分红 / guarantee_plus=保底+分红 / buyout=买断 / custom=自定义

  // 分红模式参数
  revenueRate     Float? @map("revenue_rate") // 分红比例，如 0.25
  guaranteeAmount Float? @map("guarantee_amount") // 保底金额
  buyoutAmount    Float? @map("buyout_amount") // 买断金额

  // 合同周期
  startAt DateTime  @map("start_at")
  endAt   DateTime? @map("end_at") // null = 长期有效

  // 合同条款说明（富文本或纯文本，存核心条款摘要）
  terms String? @db.Text

  // 附件（OSS objectKey，存合同扫描件等）
  attachments String? @db.Text // JSON数组

  status String @default("active") @db.VarChar(20)
  // active=生效中 / expired=已到期 / terminated=已终止

  // 结算记录（每次打款记一条，存JSON数组，简单记账）
  settlementLogs String? @map("settlement_logs") @db.Text // JSON数组

  createdBy String  @map("created_by") // 录入的管理员 userId
  note      String? @db.Text // 内部备注

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator       User? @relation("ContractCreator", fields: [creatorId], references: [id])
  createdByUser User  @relation("ContractAdmin", fields: [createdBy], references: [id])

  @@index([creatorId])
  @@index([status])
  @@map("creator_contracts")
}

// ================================================================
// 第十二组：账户安全系统 v1（6张表）
// ================================================================

// 短信验证码记录
model SmsCode {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  phone     String     @db.VarChar(20)
  code      String     @db.VarChar(10)
  purpose   SmsPurpose
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
  @@index([phone, purpose, createdAt])
  @@map("sms_codes")
}

// 短信全局计数器（每小时限额500条，防刷）
model SmsGlobalCounter {
  id        String   @id @default(uuid())
  hourKey   String   @unique @map("hour_key") @db.VarChar(20) // 如 "2025-01-01T12"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hourKey])
  @@map("sms_global_counters")
}

// 通用防刷计数桶。subject/target 仅保存带服务端密钥的哈希，不保存原始手机号或 IP。
model RateLimitBucket {
  id          String   @id @default(uuid())
  scope       String   @db.VarChar(60)
  subjectHash String   @map("subject_hash") @db.VarChar(64)
  targetHash  String   @default("") @map("target_hash") @db.VarChar(64)
  windowKey   String   @map("window_key") @db.VarChar(40)
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scope, subjectHash, targetHash, windowKey])
  @@index([scope, subjectHash, windowKey])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// 用户对协议的版本化同意记录；User 上的 privacy 字段继续作为兼容快照。
model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(30)
  version   String   @db.VarChar(30)
  scene     String   @db.VarChar(30)
  ip        String?  @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  agreedAt  DateTime @default(now()) @map("agreed_at")

  @@index([userId, type, agreedAt])
  @@index([type, version])
  @@map("consent_records")
}

// 高危操作二次验证Token（提现/改密/换手机）
model ActionToken {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  token     String     @unique
  action    ActionType
  targetId  String?    @map("target_id") // 操作目标ID（如提现账户ID）
  uaHash    String?    @map("ua_hash") // User-Agent哈希，防跨设备截用
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, action, createdAt])
  @@map("action_tokens")
}

// Refresh Token（双Token机制，存SHA256哈希）
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique // SHA256(rawToken)，明文存HttpOnly Cookie
  sessionId String?   @map("session_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Token黑名单（即时封禁/改密后立即让旧Token失效）
model TokenBlacklist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") // 黑名单记录过期时间（通常15min）
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("token_blacklist")
}

// 合规审计日志（PIPL要求，DB层只有INSERT+SELECT权限）
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(100) // 如 PRIVACY_AGREED / ALL_SESSIONS_REVOKED / ACCOUNT_DEACTIVATED
  targetId  String?  @map("target_id")
  detail    Json? // 不含明文手机号/hash/token/证件号
  ip        String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ================================================================
// 第七组：购物车系统（5张表）
// ================================================================

// 购物车主表（每个用户一张购物车）
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

// 购物车条目
model CartItem {
  id                 String   @id @default(uuid())
  cartId             String   @map("cart_id")
  itemType           String   @map("item_type") // MARKET | CUSTOM
  contentId          String   @map("content_id") // collab_work.id 或 custom_product.id
  hardwareSkuId      String   @map("hardware_sku_id") // machine_model_skus.id
  hardwareSkuCode    String?  @map("hardware_sku_code") // 冗余 skuCode 供展示
  snapshotTitle      String   @map("snapshot_title")
  snapshotPreviewUrl String?  @map("snapshot_preview_url") @db.Text // GIF 快照（定制品）
  coverUrl           String?  @map("cover_url") @db.Text // 成品封面图
  configSnapshotJson String?  @map("config_snapshot_json") @db.Text // 定制参数快照（JSON）
  snapshotPrice      Decimal? @map("snapshot_price") @db.Decimal(10, 2) // 加购时的价格快照
  quantity           Int      @default(1)
  selected           Boolean  @default(true)
  creatorId          String?  @map("creator_id")
  status             String   @default("normal") // normal|invalid|stock_out|price_changed
  customProductId    String?  @map("custom_product_id") // 仅 CUSTOM 有效
  sessionGroupId     String?  @map("session_group_id") // 同一次加购批次共享，用于购物车分组
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@index([sessionGroupId])
  @@map("cart_items")
}

// DIY 草稿工作区（7天有效，编辑器产出）
model CustomProduct {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  animationFrames    String    @map("animation_frames") @db.Text // JSON 帧图列表
  draftData          String?   @map("draft_data") @db.Text // 工程文件（7天）
  draftExpiresAt     DateTime? @map("draft_expires_at")
  previewUrl         String?   @map("preview_url") @db.Text // GIF（编辑器实时版）
  staticPreviewUrl   String?   @map("static_preview_url") @db.Text // 效果图合成 PNG
  configJson         String?   @map("config_json") @db.Text // 实时定制参数
  hardwareSkuId      String?   @map("hardware_sku_id")
  frameCount         Int?      @map("frame_count") // 帧数（用于物理校验）
  animationAssetId   String?   @map("animation_asset_id")
  animationVersionId String?   @map("animation_version_id")
  status             String    @default("draft") // draft|in_cart|ordered|removed
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  animationAsset          AnimationAsset?         @relation(fields: [animationAssetId], references: [id], onDelete: SetNull)
  animationVersion        AnimationAssetVersion?  @relation("CustomProductAnimationVersion", fields: [animationVersionId], references: [id], onDelete: SetNull)
  sourceAnimationVersions AnimationAssetVersion[] @relation("AnimationVersionSourceCustomProduct")

  @@index([userId, status])
  @@index([animationAssetId])
  @@index([animationVersionId])
  @@map("custom_products")
}

// 可复购的动画主资产。它与一次定制申请、SKU 和订单相互独立。
model AnimationAsset {
  id                  String    @id @default(uuid())
  assetNo             String    @unique @map("asset_no") @db.VarChar(32)
  ownerUserId         String?   @map("owner_user_id")
  title               String    @default("未命名动画") @db.VarChar(200)
  sourceType          String    @map("source_type") @db.VarChar(30) // SELF_SCREENED | STAFF_SCREENED | STAFF_CREATED
  sourceChannel       String    @default("WEB_CUSTOM") @map("source_channel") @db.VarChar(30) // WEB_CUSTOM | OFFLINE_CUSTOM | CREATOR_SUBMISSION | INTERNAL_CREATED
  usageType           String    @default("PRIVATE_CUSTOM") @map("usage_type") @db.VarChar(30) // PRIVATE_CUSTOM | COLLAB_SALE | COMPANY_PRODUCT | INTERNAL_TEST | UNDECIDED
  assetType           String    @default("PRIVATE") @map("asset_type") @db.VarChar(20) // PRIVATE | COLLAB
  status              String    @default("ACTIVE") @db.VarChar(30) // ACTIVE | USER_DELETED | ARCHIVED
  collabStatus        String    @default("NONE") @map("collab_status") @db.VarChar(30) // NONE | PENDING | AUTHORIZED | STOPPED
  rightsHolderType    String    @default("USER") @map("rights_holder_type") @db.VarChar(30) // USER | OFFLINE_CUSTOMER | CREATOR | COMPANY | UNCONFIRMED
  rightsHolderName    String?   @map("rights_holder_name") @db.VarChar(120)
  rightsHolderContact String?   @map("rights_holder_contact") @db.VarChar(200)
  authorizationStatus String    @default("PRIVATE_ONLY") @map("authorization_status") @db.VarChar(30) // PRIVATE_ONLY | PENDING | AUTHORIZED
  internalNotes       String?   @map("internal_notes") @db.Text
  createdByStaffId    String?   @map("created_by_staff_id")
  currentVersionNo    Int       @default(0) @map("current_version_no")
  frontDeletedAt      DateTime? @map("front_deleted_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  owner                 User?                   @relation("AnimationAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdByStaff        User?                   @relation("AnimationAssetCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  versions              AnimationAssetVersion[]
  customProducts        CustomProduct[]
  customizationRequests CustomizationRequest[]
  salesOrderItems       SalesOrderItem[]
  collabWorks           CollabWork[]
  tags                  AnimationAssetTag[]
  sourceDraft           FrameAssetDraft?
  productionFiles       ProductionPrintFile[]

  @@index([ownerUserId, status, updatedAt])
  @@index([assetType, collabStatus])
  @@index([sourceChannel, usageType, status])
  @@index([createdByStaffId, createdAt])
  @@map("animation_assets")
}

model AnimationTag {
  id        String              @id @default(uuid())
  name      String              @unique @db.VarChar(40)
  color     String?             @db.VarChar(20)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  assets    AnimationAssetTag[]

  @@map("animation_tags")
}

model AnimationAssetTag {
  assetId   String         @map("asset_id")
  tagId     String         @map("tag_id")
  createdAt DateTime       @default(now()) @map("created_at")
  asset     AnimationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       AnimationTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId, assetId])
  @@map("animation_asset_tags")
}

// 后台把视频/GIF/图片组制作成正式 ANM 前的可恢复工作草稿。
model FrameAssetDraft {
  id                  String    @id @default(uuid())
  draftNo             String    @unique @map("draft_no") @db.VarChar(32)
  status              String    @default("DRAFT") @db.VarChar(20) // DRAFT | READY_FOR_REVIEW | PUBLISHED | ABANDONED
  createdByStaffId    String    @map("created_by_staff_id")
  lastEditedByStaffId String    @map("last_edited_by_staff_id")
  sourceKeys          Json      @map("source_keys")
  sourceType          String    @map("source_type") @db.VarChar(20) // VIDEO | GIF | IMAGES
  sourceMetadata      Json?     @map("source_metadata")
  editorData          Json?     @map("editor_data")
  title               String    @default("未命名动画") @db.VarChar(200)
  targetRatio         String    @default("1:1") @map("target_ratio") @db.VarChar(20)
  sourceChannel       String    @default("INTERNAL_CREATED") @map("source_channel") @db.VarChar(30)
  usageType           String    @default("INTERNAL_TEST") @map("usage_type") @db.VarChar(30)
  rightsHolderType    String    @default("COMPANY") @map("rights_holder_type") @db.VarChar(30)
  rightsHolderName    String?   @map("rights_holder_name") @db.VarChar(120)
  rightsHolderContact String?   @map("rights_holder_contact") @db.VarChar(200)
  authorizationStatus String    @default("PRIVATE_ONLY") @map("authorization_status") @db.VarChar(30)
  ownerUserId         String?   @map("owner_user_id")
  tags                Json?
  internalNotes       String?   @map("internal_notes") @db.Text
  revision            Int       @default(1)
  animationAssetId    String?   @unique @map("animation_asset_id")
  publishedAt         DateTime? @map("published_at")
  abandonedAt         DateTime? @map("abandoned_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  createdByStaff User            @relation("FrameAssetDraftCreator", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  lastEditedBy   User            @relation("FrameAssetDraftEditor", fields: [lastEditedByStaffId], references: [id], onDelete: Restrict)
  owner          User?           @relation("FrameAssetDraftOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  animationAsset AnimationAsset? @relation(fields: [animationAssetId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([createdByStaffId, status])
  @@map("frame_asset_drafts")
}

// 一旦确认便不可覆盖的核心帧版本。重新编辑必须新增 versionNo。
model AnimationAssetVersion {
  id                     String   @id @default(uuid())
  assetId                String   @map("asset_id")
  versionNo              Int      @map("version_no")
  sourceKey              String   @unique @map("source_key") @db.VarChar(120)
  sourceType             String   @map("source_type") @db.VarChar(30)
  sourceRequestId        String?  @map("source_request_id")
  sourceFrameSelectionId String?  @unique @map("source_frame_selection_id")
  sourceCustomProductId  String?  @map("source_custom_product_id")
  createdByUserId        String?  @map("created_by_user_id")
  frameKeys              Json     @map("frame_keys")
  baseFrameCount         Int      @map("base_frame_count")
  editorData             Json?    @map("editor_data")
  manifestHash           String   @map("manifest_hash") @db.VarChar(64)
  createdAt              DateTime @default(now()) @map("created_at")

  asset                AnimationAsset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sourceRequest        CustomizationRequest?        @relation("AnimationVersionSourceRequest", fields: [sourceRequestId], references: [id], onDelete: SetNull)
  sourceFrameSelection CustomizationFrameSelection? @relation("AnimationVersionSourceSelection", fields: [sourceFrameSelectionId], references: [id], onDelete: SetNull)
  sourceCustomProduct  CustomProduct?               @relation("AnimationVersionSourceCustomProduct", fields: [sourceCustomProductId], references: [id], onDelete: SetNull)
  createdBy            User?                        @relation("AnimationVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customProducts       CustomProduct[]              @relation("CustomProductAnimationVersion")
  acceptedRequests     CustomizationRequest[]       @relation("CustomizationAcceptedAnimationVersion")
  salesOrderItems      SalesOrderItem[]
  collabWorks          CollabWork[]
  productionRenders    ProductionFrameRender[]
  productionFiles      ProductionPrintFile[]

  @@unique([assetId, versionNo])
  @@index([assetId, createdAt])
  @@index([sourceRequestId])
  @@index([sourceCustomProductId])
  @@map("animation_asset_versions")
}

// 同一个动画版本在同一尺寸下只拼接一次；目标帧数通过循环插入复用这些无损 PNG。
model ProductionFrameRender {
  id                 String   @id @default(uuid())
  animationVersionId String   @map("animation_version_id")
  size               String   @db.VarChar(20)
  widthPx            Int      @map("width_px")
  heightPx           Int      @map("height_px")
  dpi                Int
  separatorMicrons   Int      @map("separator_microns")
  markerEnabled      Boolean  @default(true) @map("marker_enabled")
  processorVersion   String   @map("processor_version") @db.VarChar(30)
  frameKeys          Json     @map("frame_keys")
  manifestHash       String   @map("manifest_hash") @db.VarChar(64)
  status             String   @default("READY") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")

  animationVersion AnimationAssetVersion @relation(fields: [animationVersionId], references: [id], onDelete: Restrict)
  files            ProductionPrintFile[]

  @@unique([animationVersionId, size, dpi, separatorMicrons, markerEnabled, processorVersion])
  @@index([animationVersionId, createdAt])
  @@map("production_frame_renders")
}

// 可下载的正式 Word 生产文件。相同规格重新生成时递增 fileVersionNo，不覆盖旧文件。
model ProductionPrintFile {
  id                 String   @id @default(uuid())
  assetId            String   @map("asset_id")
  animationVersionId String   @map("animation_version_id")
  renderId           String   @map("render_id")
  templateVersionId  String   @map("template_version_id")
  targetFrameCount   Int      @map("target_frame_count")
  fileVersionNo      Int      @map("file_version_no")
  displayName        String   @map("display_name") @db.VarChar(255)
  objectKey          String   @unique @map("object_key") @db.VarChar(500)
  manifestHash       String   @map("manifest_hash") @db.VarChar(64)
  sourceType         String   @default("MANUAL") @map("source_type") @db.VarChar(20)
  productionBatchId  String?  @map("production_batch_id") @db.VarChar(40)
  status             String   @default("READY") @db.VarChar(20)
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  asset            AnimationAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  animationVersion AnimationAssetVersion @relation(fields: [animationVersionId], references: [id], onDelete: Restrict)
  render           ProductionFrameRender @relation(fields: [renderId], references: [id], onDelete: Restrict)
  templateVersion  PrintTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@unique([animationVersionId, templateVersionId, targetFrameCount, fileVersionNo])
  @@index([assetId, animationVersionId, createdAt])
  @@index([productionBatchId])
  @@map("production_print_files")
}

// 定制审核申请。与购物车、订单、生产任务分开，正式提交后生成 requestNo。
model CustomizationRequest {
  id                         String    @id @default(uuid())
  requestNo                  String?   @unique @map("request_no") @db.VarChar(32)
  userId                     String    @map("user_id")
  mode                       String    @db.VarChar(20) // SELF | HUMAN
  status                     String    @default("DRAFT") @db.VarChar(30)
  version                    Int       @default(1)
  clientDraftKey             String?   @unique @map("client_draft_key") @db.VarChar(80)
  customProductId            String?   @map("custom_product_id")
  machineModelId             String?   @map("machine_model_id")
  desiredSkuId               String?   @map("desired_sku_id")
  animationAssetId           String?   @map("animation_asset_id")
  acceptedAnimationVersionId String?   @map("accepted_animation_version_id")
  sourceKeys                 Json      @map("source_keys")
  selectedFrameKeys          Json?     @map("selected_frame_keys")
  screeningData              Json?     @map("screening_data")
  editorData                 Json?     @map("editor_data")
  userNote                   String?   @map("user_note") @db.Text
  creatorDeclared            Boolean   @default(false) @map("creator_declared")
  copyrightConfirmed         Boolean   @default(false) @map("copyright_confirmed")
  cooperationInterested      Boolean   @default(false) @map("cooperation_interested")
  assignedStaffId            String?   @map("assigned_staff_id")
  claimedAt                  DateTime? @map("claimed_at")
  lockExpiresAt              DateTime? @map("lock_expires_at")
  staffDraftData             Json?     @map("staff_draft_data")
  staffDraftUpdatedAt        DateTime? @map("staff_draft_updated_at")
  submittedAt                DateTime? @map("submitted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user                      User                          @relation("CustomizationRequester", fields: [userId], references: [id])
  assignedStaff             User?                         @relation("CustomizationAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  events                    CustomizationRequestEvent[]
  frameSelections           CustomizationFrameSelection[]
  animationAsset            AnimationAsset?               @relation(fields: [animationAssetId], references: [id], onDelete: SetNull)
  acceptedAnimationVersion  AnimationAssetVersion?        @relation("CustomizationAcceptedAnimationVersion", fields: [acceptedAnimationVersionId], references: [id], onDelete: SetNull)
  producedAnimationVersions AnimationAssetVersion[]       @relation("AnimationVersionSourceRequest")

  @@index([userId, status, createdAt])
  @@index([status, submittedAt])
  @@index([machineModelId])
  @@index([animationAssetId])
  @@index([acceptedAnimationVersionId])
  @@index([assignedStaffId, status])
  @@map("customization_requests")
}

// 工作人员每次正式提交的筛帧结果。新版本追加保存，不覆盖旧结果。
model CustomizationFrameSelection {
  id                String                 @id @default(uuid())
  requestId         String                 @map("request_id")
  version           Int
  selectedFrameKeys Json                   @map("selected_frame_keys")
  editorData        Json?                  @map("editor_data")
  staffMessage      String?                @map("staff_message") @db.Text
  internalNote      String?                @map("internal_note") @db.Text
  status            String                 @default("SUBMITTED") @db.VarChar(30)
  createdByStaffId  String?                @map("created_by_staff_id")
  submittedAt       DateTime               @default(now()) @map("submitted_at")
  respondedAt       DateTime?              @map("responded_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  animationVersion  AnimationAssetVersion? @relation("AnimationVersionSourceSelection")

  request        CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdByStaff User?                @relation("CustomizationFrameSelectionStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@unique([requestId, version])
  @@index([requestId, status, createdAt])
  @@index([createdByStaffId, createdAt])
  @@map("customization_frame_selections")
}

// 定制申请的追加式时间线。业务状态改变时新增记录，不覆盖历史。
model CustomizationRequestEvent {
  id            String   @id @default(uuid())
  requestId     String   @map("request_id")
  actorUserId   String?  @map("actor_user_id")
  actorType     String   @map("actor_type") @db.VarChar(20) // USER | STAFF | SYSTEM
  eventType     String   @map("event_type") @db.VarChar(40)
  fromStatus    String?  @map("from_status") @db.VarChar(30)
  toStatus      String?  @map("to_status") @db.VarChar(30)
  publicMessage String?  @map("public_message") @db.Text
  internalNote  String?  @map("internal_note") @db.Text
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  request CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?                @relation("CustomizationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("customization_request_events")
}

// 预订单（10分钟库存锁定，支付前临时凭据）
model PreOrder {
  id                     String      @id @default(uuid())
  userId                 String      @map("user_id")
  cartItemIds            String      @map("cart_item_ids") @db.Text // JSON 数组，幂等校验用
  checkoutIdempotencyKey String      @unique @map("checkout_idempotency_key")
  status                 String      @default("pending_payment") // pending_payment|paid|expired|cancelled
  orderType              String      @default("normal") @map("order_type") // normal|presale
  discountAdjustment     Decimal?    @map("discount_adjustment") @db.Decimal(10, 2)
  totalAmount            Decimal     @map("total_amount") @db.Decimal(10, 2)
  // 收件信息（结算时填写，字段名与 customize_orders 统一用 receiver*）
  receiverName           String?     @map("receiver_name")
  receiverPhone          String?     @map("receiver_phone")
  receiverAddress        String?     @map("receiver_address") @db.Text
  receiverCity           String?     @map("receiver_city")
  expiresAt              DateTime    @map("expires_at") // 创建时间 + 10分钟
  wxPayParams            String?     @map("wx_pay_params") @db.Text // 微信支付参数 JSON
  createdAt              DateTime    @default(now()) @map("created_at")
  salesOrder             SalesOrder?

  @@index([userId, status])
  @@index([expiresAt])
  @@map("pre_orders")
}

// 一次支付对应一个用户订单。商品和生产任务在下方分层保存。
model SalesOrder {
  id              String    @id @default(uuid())
  orderNo         String    @unique @map("order_no") @db.VarChar(32)
  userId          String    @map("user_id")
  preOrderId      String    @unique @map("pre_order_id")
  status          String    @default("paid") @db.VarChar(20)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(10, 2)
  receiverName    String?   @map("receiver_name")
  receiverPhone   String?   @map("receiver_phone")
  receiverAddress String?   @map("receiver_address") @db.Text
  receiverCity    String?   @map("receiver_city")
  platform        String    @default("SELF") @db.VarChar(20)
  paidAt          DateTime? @map("paid_at")
  cancelledAt     DateTime? @map("cancelled_at")
  receivedAt      DateTime? @map("received_at")
  fulfillmentStatus String   @default("PAID") @map("fulfillment_status") @db.VarChar(30)
  // PAID / PENDING_ADDRESS_EXPORT / WAITING_TRACKING / READY_FOR_PRODUCTION /
  // PRODUCING / READY_TO_SHIP / SHIPPED
  addressExportedAt DateTime? @map("address_exported_at")
  trackingNo        String?   @map("tracking_no") @db.VarChar(100)
  trackingCompany   String?   @map("tracking_company") @db.VarChar(100)
  trackingBoundAt   DateTime? @map("tracking_bound_at")
  productionStartedAt DateTime? @map("production_started_at")
  readyToShipAt     DateTime? @map("ready_to_ship_at")
  shippedAt         DateTime? @map("shipped_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id])
  preOrder              PreOrder               @relation(fields: [preOrderId], references: [id], onDelete: Restrict)
  items                 SalesOrderItem[]
  productionBatchOrders ProductionBatchOrder[]

  @@index([userId, status, createdAt])
  @@map("sales_orders")
}

// 私人定制帧素材包的单件身份。一个 PU 重做时递增 attemptNo，旧尝试保留为 VOID。
model ProductionFramePack {
  id                 String   @id @default(uuid())
  code               String   @unique @db.VarChar(80)
  productionUnitId   String   @map("production_unit_id")
  salesOrderId       String   @map("sales_order_id")
  batchId            String   @map("batch_id") @db.VarChar(40)
  skuId              String   @map("sku_id")
  animationVersionId String?  @map("animation_version_id")
  targetFrameCount   Int      @map("target_frame_count")
  size               String   @db.VarChar(30)
  attemptNo          Int      @default(1) @map("attempt_no")
  status             String   @default("CREATED") @db.VarChar(20)
  // CREATED / IN_PROGRESS / PAIRED / PACKED / SHIPPED / VOID
  isActive           Boolean  @default(true) @map("is_active")
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([productionUnitId, attemptNo])
  @@index([batchId, status])
  @@index([salesOrderId, status])
  @@map("production_frame_packs")
}

// 帧包与标准材料包批次的逐件配对记录。
model ProductionUnitPairing {
  id                 String    @id @default(uuid())
  productionUnitId   String    @unique @map("production_unit_id")
  salesOrderId       String    @map("sales_order_id")
  batchId            String    @map("batch_id") @db.VarChar(40)
  framePackId        String    @unique @map("frame_pack_id")
  skuId              String    @map("sku_id")
  kitAssemblyBatchId String    @map("kit_assembly_batch_id")
  kitContainerId     String?   @map("kit_container_id")
  status             String    @default("PAIRED") @db.VarChar(20)
  // PAIRED / PACKED / SHIPPED / VOID
  pairedBy           String    @map("paired_by")
  pairedAt           DateTime  @default(now()) @map("paired_at")
  packedAt           DateTime? @map("packed_at")
  shippedAt          DateTime? @map("shipped_at")

  @@index([batchId, status])
  @@index([salesOrderId, status])
  @@index([kitAssemblyBatchId])
  @@map("production_unit_pairings")
}

// 一个总订单只有一个当前装箱会话；扫码结果保存在服务端，刷新页面不会丢失。
model ProductionPackingSession {
  id           String    @id @default(uuid())
  salesOrderId String    @unique @map("sales_order_id")
  batchId      String    @map("batch_id") @db.VarChar(40)
  trackingNo   String    @map("tracking_no") @db.VarChar(100)
  status       String    @default("OPEN") @db.VarChar(20)
  // OPEN / COMPLETE / SHIPPED
  startedBy    String    @map("started_by")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  shippedAt    DateTime? @map("shipped_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scans ProductionPackingScan[]

  @@index([trackingNo])
  @@index([batchId, status])
  @@map("production_packing_sessions")
}

model ProductionPackingScan {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  productionUnitId String   @map("production_unit_id")
  framePackId      String   @map("frame_pack_id")
  scannedBy        String   @map("scanned_by")
  scannedAt        DateTime @default(now()) @map("scanned_at")

  session ProductionPackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productionUnitId])
  @@index([framePackId])
  @@map("production_packing_scans")
}

// 用户订单中的一条商品，锁定成交时的动画版本、SKU、数量和价格快照。
model SalesOrderItem {
  id                 String   @id @default(uuid())
  itemNo             String   @unique @map("item_no") @db.VarChar(40)
  salesOrderId       String   @map("sales_order_id")
  cartItemId         String?  @map("cart_item_id")
  itemType           String   @map("item_type") @db.VarChar(20)
  contentId          String   @map("content_id")
  customProductId    String?  @map("custom_product_id")
  animationAssetId   String?  @map("animation_asset_id")
  animationVersionId String?  @map("animation_version_id")
  skuId              String   @map("sku_id")
  skuCode            String?  @map("sku_code")
  snapshotTitle      String   @map("snapshot_title")
  snapshotPreviewUrl String?  @map("snapshot_preview_url") @db.Text
  configSnapshotJson String?  @map("config_snapshot_json") @db.Text
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity           Int
  lineTotal          Decimal  @map("line_total") @db.Decimal(10, 2)
  status             String   @default("paid") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  salesOrder       SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  animationAsset   AnimationAsset?        @relation(fields: [animationAssetId], references: [id], onDelete: SetNull)
  animationVersion AnimationAssetVersion? @relation(fields: [animationVersionId], references: [id], onDelete: SetNull)
  productionTasks  CustomizeOrder[]

  @@index([salesOrderId])
  @@index([animationAssetId, animationVersionId])
  @@index([skuId])
  @@map("sales_order_items")
}

// 用户收货地址簿
model UserAddress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String? // 「家」「公司」「学校」等标签
  name      String // 收件人姓名
  phone     String // 手机号
  province  String // 省
  city      String // 市
  district  String // 区/县
  detail    String   @db.Text // 详细地址（街道、楼号等）
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_addresses")
}

// 限量内容配额（限量版联名作品销售控制）
model ContentQuota {
  id           String   @id @default(uuid())
  collabWorkId String   @unique @map("collab_work_id")
  totalQuota   Int      @map("total_quota") // 总配额
  usedQuota    Int      @default(0) @map("used_quota") // 已售出
  lockedQuota  Int      @default(0) @map("locked_quota") // 预锁（pending_payment）
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("content_quotas")
}

// ================================================================
// 材料包物品管理（辅助耗材体系，独立于机型SKU）
// ================================================================

// 材料物品清单
model InventoryFormOption {
  id        String   @id @default(uuid())
  category  String   @db.VarChar(20) // NAME / UNIT
  scope     String   @db.VarChar(20) // RAW / PACKED / ALL
  value     String   @db.VarChar(100)
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, scope, value])
  @@index([category, scope])
  @@map("inventory_form_options")
}

model MaterialItem {
  id               String   @id @default(uuid())
  itemCode         String?  @unique @map("item_code") @db.VarChar(50)
  name             String   @db.VarChar(100)
  itemType         String   @default("RAW") @map("item_type") @db.VarChar(20) // RAW / PACKED / CONSUMABLE
  specification    String?  @db.VarChar(200)
  unit             String   @default("个") @db.VarChar(20)
  currentStock     Int      @default(0) @map("current_stock")
  serviceStock     Int      @default(0) @map("service_stock")
  safetyStock      Int      @default(10) @map("safety_stock")
  leadTime         Int      @default(7) @map("lead_time") // 采购周期（天）
  note             String?  @db.VarChar(200)
  sourceMaterialId String?  @map("source_material_id")
  sourceQtyPerUnit Int?     @map("source_qty_per_unit")
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  logs        MaterialLog[]
  skuBindings MaterialSkuBinding[]
  receipts    MaterialReceipt[]

  @@map("material_items")
}

// 材料操作日志
model MaterialLog {
  id          String   @id @default(uuid())
  materialId  String   @map("material_id")
  // purchase_in / order_consumed / production_defect / manual_adjustment / opening_stock
  type        String   @db.VarChar(30)
  quantity    Int
  beforeQty   Int      @map("before_qty")
  afterQty    Int      @map("after_qty")
  operatorId  String   @map("operator_id")
  note        String?  @db.VarChar(200)
  orderId     String?  @map("order_id")
  referenceNo String?  @map("reference_no") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  material MaterialItem @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@map("material_logs")
}

// 材料-SKU 绑定关系（每出货1个SKU自动扣减对应材料）
model MaterialSkuBinding {
  id         String   @id @default(uuid())
  materialId String   @map("material_id")
  skuId      String   @map("sku_id") // machine_model_skus.id
  qtyPerUnit Int      @default(1) @map("qty_per_unit") // 每出1个SKU消耗的材料数量
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  material MaterialItem @relation(fields: [materialId], references: [id])

  @@unique([materialId, skuId])
  @@map("material_sku_bindings")
}

model MaterialReceipt {
  id                    String   @id @default(uuid())
  receiptNo             String   @unique @map("receipt_no") @db.VarChar(50)
  materialId            String   @map("material_id")
  orderedSpec           String?  @map("ordered_spec") @db.VarChar(200)
  actualQty             Int      @map("actual_qty")
  acceptedQty           Int      @map("accepted_qty")
  availableQty          Int      @default(0) @map("available_qty")
  rejectedQty           Int      @default(0) @map("rejected_qty")
  supplierName          String?  @map("supplier_name") @db.VarChar(100)
  supplierLotNo         String?  @map("supplier_lot_no") @db.VarChar(100)
  location              String?  @db.VarChar(100)
  status                String   @default("AVAILABLE") @db.VarChar(20)
  stockClass            String   @default("NEW") @map("stock_class") @db.VarChar(20)
  sourceReturnReceiptId String?  @map("source_return_receipt_id")
  operatorId            String   @map("operator_id")
  note                  String?  @db.VarChar(300)
  createdAt             DateTime @default(now()) @map("created_at")

  material MaterialItem @relation(fields: [materialId], references: [id])

  @@index([materialId, createdAt])
  @@map("material_receipts")
}

model MaterialPreparationBatch {
  id                    String   @id @default(uuid())
  batchNo               String   @unique @map("batch_no") @db.VarChar(50)
  outputMaterialId      String   @map("output_material_id")
  outputQty             Int      @map("output_qty")
  availableQty          Int      @default(0) @map("available_qty")
  location              String?  @db.VarChar(100)
  status                String   @default("AVAILABLE") @db.VarChar(20)
  stockClass            String   @default("NEW") @map("stock_class") @db.VarChar(20)
  sourceReturnReceiptId String?  @map("source_return_receipt_id")
  operatorId            String   @map("operator_id")
  note                  String?  @db.VarChar(300)
  createdAt             DateTime @default(now()) @map("created_at")

  inputs MaterialPreparationInput[]

  @@index([outputMaterialId, createdAt])
  @@map("material_preparation_batches")
}

model MaterialPreparationInput {
  id              String  @id @default(uuid())
  prepBatchId     String  @map("prep_batch_id")
  materialId      String  @map("material_id")
  usedQty         Int     @map("used_qty")
  lossQty         Int     @default(0) @map("loss_qty")
  sourceReceiptId String? @map("source_receipt_id")

  batch MaterialPreparationBatch @relation(fields: [prepBatchId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_preparation_inputs")
}

model KitContainer {
  id         String   @id @default(uuid())
  code       String   @unique @db.VarChar(50)
  skuId      String   @map("sku_id")
  currentQty Int      @default(0) @map("current_qty")
  location   String?  @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  assemblies KitAssemblyBatch[]

  @@index([skuId])
  @@map("kit_containers")
}

model KitAssemblyBatch {
  id                    String   @id @default(uuid())
  batchNo               String   @unique @map("batch_no") @db.VarChar(50)
  skuId                 String   @map("sku_id")
  quantity              Int
  availableQty          Int      @default(0) @map("available_qty")
  status                String   @default("AVAILABLE") @db.VarChar(20)
  stockClass            String   @default("NEW") @map("stock_class") @db.VarChar(20)
  batchType             String   @default("ASSEMBLED") @map("batch_type") @db.VarChar(30)
  sourceReturnReceiptId String?  @map("source_return_receipt_id")
  bomVersion            Int      @map("bom_version")
  bomSnapshot           String   @map("bom_snapshot")
  containerId           String?  @map("container_id")
  operatorId            String   @map("operator_id")
  note                  String?  @db.VarChar(300)
  createdAt             DateTime @default(now()) @map("created_at")

  container    KitContainer?            @relation(fields: [containerId], references: [id])
  consumptions KitAssemblyConsumption[]

  @@index([skuId, createdAt])
  @@index([containerId])
  @@map("kit_assembly_batches")
}

model KitAssemblyConsumption {
  id                 String   @id @default(uuid())
  kitAssemblyBatchId String   @map("kit_assembly_batch_id")
  materialId         String   @map("material_id")
  sourceType         String   @map("source_type") @db.VarChar(20)
  sourceBatchId      String   @map("source_batch_id")
  quantity           Int
  createdAt          DateTime @default(now()) @map("created_at")

  batch KitAssemblyBatch @relation(fields: [kitAssemblyBatchId], references: [id], onDelete: Cascade)

  @@index([kitAssemblyBatchId])
  @@index([sourceType, sourceBatchId])
  @@map("kit_assembly_consumptions")
}

model InventoryReturnReceipt {
  id                 String    @id @default(uuid())
  returnNo           String    @unique @map("return_no") @db.VarChar(50)
  aftersaleRequestId String    @map("aftersale_request_id")
  orderId            String    @map("order_id")
  trackingNo         String?   @map("tracking_no") @db.VarChar(100)
  trackingCompany    String?   @map("tracking_company") @db.VarChar(100)
  status             String    @default("QUARANTINED") @db.VarChar(30)
  receivedBy         String    @map("received_by")
  receivedAt         DateTime  @default(now()) @map("received_at")
  inspectedBy        String?   @map("inspected_by")
  inspectedAt        DateTime? @map("inspected_at")
  note               String?   @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  items InventoryReturnInspectionItem[]

  @@index([status, receivedAt])
  @@index([aftersaleRequestId])
  @@map("inventory_return_receipts")
}

model InventoryReturnInspectionItem {
  id              String   @id @default(uuid())
  returnReceiptId String   @map("return_receipt_id")
  inventoryLevel  String   @map("inventory_level") @db.VarChar(30)
  materialId      String?  @map("material_id")
  skuId           String?  @map("sku_id")
  receivedQty     Int      @map("received_qty")
  disposition     String   @db.VarChar(30)
  resultBatchType String?  @map("result_batch_type") @db.VarChar(30)
  resultBatchId   String?  @map("result_batch_id")
  note            String?  @db.VarChar(300)
  createdAt       DateTime @default(now()) @map("created_at")

  returnReceipt InventoryReturnReceipt @relation(fields: [returnReceiptId], references: [id], onDelete: Cascade)

  @@index([returnReceiptId])
  @@map("inventory_return_inspection_items")
}

// ================================================================
// 创作者通知
// ================================================================

model CreatorNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(30)
  // approved | rejected | offshelf | onshelf | revision_approved | revision_rejected
  workId    String   @map("work_id")
  workTitle String   @map("work_title") @db.VarChar(100)
  message   String?  @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("creator_notifications")
}
