// ================================================================
// 哞屋 MOWO 平台 — Prisma Schema
// 数据库：PostgreSQL
// 共25张表
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================================
// 第一组：用户与身份（7张表）
// ================================================================

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  passwordHash  String    @map("password_hash")
  certifyStatus Int       @default(0) @map("certify_status") // 0未申请 1审核中 2通过 3拒绝
  isBanned      Boolean   @default(false) @map("is_banned")
  role          Int       @default(0) // 0=User 1=Production 2=Admin 3=SuperAdmin
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile             UserProfile?
  creatorProfile      CreatorProfile?
  certifyApplications CertifyApplication[]
  creditScore         CreditScore?
  creditLogs          CreditLog[]
  reportsMade         Report[]             @relation("ReporterRelation")
  articles            Article[]
  comments            Comment[]
  likes               Like[]
  collects            Collect[]
  following           Follow[]             @relation("FollowerRelation")
  followers           Follow[]             @relation("FollowingRelation")
  animations          Animation[]
  products            Product[]
  earnings            Earning[]
  balance             Balance?
  withdrawalRequests  WithdrawalRequest[]
  customizeOrders     CustomizeOrder[]
  creatorReserve      CreatorReserve?
  reserveLogs         ReserveLog[]
  settlementRecords   SettlementRecord[]
  settledRecords      SettlementRecord[]   @relation("SettlementAdmin")

  @@map("users")
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  nickname       String?   @db.VarChar(50)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  bio            String?   @db.Text
  gender         Int       @default(0) // 0保密 1男 2女
  birthday       DateTime? @db.Date
  city           String?   @db.VarChar(50)
  mbti           String?   @db.VarChar(4)
  email          String?   @db.VarChar(100)
  followerCount  Int       @default(0) @map("follower_count")
  followingCount Int       @default(0) @map("following_count")
  articleCount   Int       @default(0) @map("article_count")
  likedCount     Int       @default(0) @map("liked_count")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model CreatorProfile {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  styleTags        String?   @map("style_tags") @db.VarChar(500)
  weiboUrl         String?   @map("weibo_url") @db.VarChar(500)
  xiaohongshuUrl   String?   @map("xiaohongshu_url") @db.VarChar(500)
  bilibiliUrl      String?   @map("bilibili_url") @db.VarChar(500)
  totalSales       Int       @default(0) @map("total_sales")
  productCount     Int       @default(0) @map("product_count")
  // 牛量系统（阶段2填逻辑，字段先预留）
  bullLevel        Int       @default(1) @map("bull_level")         // 1=萌牛 2=勤牛 3=红牛 4=神牛 5=牛王
  bullScore        Float     @default(0) @map("bull_score")         // 综合牛量积分
  bullCoefficient  Float     @default(1.0) @map("bull_coefficient") // 牛量系数 0.8~2.0
  // 签约体系（阶段3填逻辑）
  isExclusive        Boolean   @default(false) @map("is_exclusive")
  exclusiveSignedAt  DateTime? @map("exclusive_signed_at")
  exclusiveExpiredAt DateTime? @map("exclusive_expired_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("creator_profiles")
}

model CertifyApplication {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  creatorName        String    @map("creator_name") @db.VarChar(100)
  creatorType        String    @map("creator_type") @db.VarChar(20)
  mainStyle          String?   @map("main_style") @db.VarChar(500)
  portfolioUrls      String?   @map("portfolio_urls") @db.Text
  realName           String    @map("real_name") @db.VarChar(50)
  idNumberLast4      String    @map("id_number_last4") @db.VarChar(4)
  certifyPassed      Boolean   @default(false) @map("certify_passed")
  copyrightConfirmed Boolean   @default(false) @map("copyright_confirmed")
  agreementConfirmed Boolean   @default(false) @map("agreement_confirmed")
  status             String    @default("pending") @db.VarChar(20)
  rejectReason       String?   @map("reject_reason") @db.VarChar(500)
  appliedAt          DateTime  @default(now()) @map("applied_at")
  reviewedAt         DateTime? @map("reviewed_at")

  user User @relation(fields: [userId], references: [id])

  @@map("certify_applications")
}

model CreditScore {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  score     Int      @default(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_scores")
}

model CreditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  delta     Int
  reason    String   @db.VarChar(100)
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("credit_logs")
}

model Report {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  targetType  String    @map("target_type") @db.VarChar(20)
  targetId    String    @map("target_id")
  reason      String    @db.VarChar(50)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(20)
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id])

  @@map("reports")
}

// ================================================================
// 第二组：文章与社区（6张表）
// ================================================================

model Article {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String    @db.VarChar(200)
  content      String    @db.Text
  coverUrl     String?   @map("cover_url") @db.VarChar(500)
  tags         String?   @db.VarChar(500)
  status       String    @default("pending") @db.VarChar(20)
  rejectReason String?   @map("reject_reason") @db.VarChar(500)
  viewCount    Int       @default(0) @map("view_count")
  likeCount    Int       @default(0) @map("like_count")
  collectCount Int       @default(0) @map("collect_count")
  commentCount Int       @default(0) @map("comment_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  articleProducts ArticleProduct[]
  comments        Comment[]
  collects        Collect[]

  @@map("articles")
}

model ArticleProduct {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  productId String   @map("product_id")
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([articleId, productId])
  @@map("article_products")
}

model Comment {
  id            String    @id @default(uuid())
  articleId     String    @map("article_id")
  userId        String    @map("user_id")
  parentId      String?   @map("parent_id")
  replyToUserId String?   @map("reply_to_user_id")
  content       String    @db.Text
  likeCount     Int       @default(0) @map("like_count")
  status        String    @default("published") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")

  article Article   @relation(fields: [articleId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Like {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@map("likes")
}

model Collect {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@map("collects")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("FollowerRelation", fields: [followerId], references: [id])
  following User @relation("FollowingRelation", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@map("follows")
}

// ================================================================
// 第三组：动画内容与商品（5张表）
// ================================================================

model Animation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String   @db.VarChar(200)
  description   String?  @db.Text
  previewUrl    String?  @map("preview_url") @db.VarChar(500)
  frameCount    Int      @map("frame_count")
  copyrightType String   @map("copyright_type") @db.VarChar(20)
  copyrightNote String?  @map("copyright_note") @db.Text
  status        String   @default("draft") @db.VarChar(20)
  fileHash      String?  @map("file_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id])
  frames   AnimationFrame[]
  products Product[]

  @@map("animations")
}

model AnimationFrame {
  id          String   @id @default(uuid())
  animationId String   @map("animation_id")
  frameIndex  Int      @map("frame_index")
  imageUrl    String   @map("image_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  animation Animation @relation(fields: [animationId], references: [id])

  @@unique([animationId, frameIndex])
  @@map("animation_frames")
}

model Product {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  animationId    String   @map("animation_id")
  crmebProductId String?  @map("crmeb_product_id") @db.VarChar(100)
  title          String   @db.VarChar(200)
  description    String?  @db.Text
  machineType    String   @map("machine_type") @db.VarChar(20)
  frameCount     Int      @map("frame_count")
  basePrice      Decimal  @map("base_price") @db.Decimal(10, 2)
  markupPrice    Decimal  @map("markup_price") @db.Decimal(10, 2)
  finalPrice     Decimal  @map("final_price") @db.Decimal(10, 2)
  stockType      String   @default("unlimited") @map("stock_type") @db.VarChar(20)
  stockLimit     Int?     @map("stock_limit")
  status         String   @default("pending") @db.VarChar(20)
  rejectReason   String?  @map("reject_reason") @db.VarChar(500)
  salesCount     Int      @default(0) @map("sales_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  animation       Animation        @relation(fields: [animationId], references: [id])
  articleProducts ArticleProduct[]
  orderExts       OrderExt[]
  earnings        Earning[]

  @@map("products")
}

model OrderExt {
  id               String   @id @default(uuid())
  crmebOrderId     String   @map("crmeb_order_id") @db.VarChar(100)
  productId        String   @map("product_id")
  animationId      String   @map("animation_id")
  buyerId          String   @map("buyer_id")
  creatorId        String   @map("creator_id")
  finalPrice       Decimal  @map("final_price") @db.Decimal(10, 2)
  platformFeeRate  Decimal  @map("platform_fee_rate") @db.Decimal(5, 2)
  platformFee      Decimal  @map("platform_fee") @db.Decimal(10, 2)
  creatorIncome    Decimal  @map("creator_income") @db.Decimal(10, 2)
  productionStatus String   @default("waiting") @map("production_status") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("orders_ext")
}

model PlatformRule {
  id          String   @id @default(uuid())
  ruleKey     String   @unique @map("rule_key") @db.VarChar(50)
  ruleValue   Decimal  @map("rule_value") @db.Decimal(10, 2)
  description String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_rules")
}

// ================================================================
// 第四组：收益与提现（3张表）
// ================================================================

model Earning {
  id              String    @id @default(uuid())
  creatorId       String    @map("creator_id")
  orderExtId      String    @map("order_ext_id")
  productId       String    @map("product_id")
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(10, 2)
  platformFeeRate Decimal   @map("platform_fee_rate") @db.Decimal(5, 2)
  platformFee     Decimal   @map("platform_fee") @db.Decimal(10, 2)
  netAmount       Decimal   @map("net_amount") @db.Decimal(10, 2)
  status          String    @default("pending") @db.VarChar(20)
  // pending待结算 / available可提现 / withdrawn已提现
  availableAt     DateTime? @map("available_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  creator User    @relation(fields: [creatorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("earnings")
}

model Balance {
  id              String   @id @default(uuid())
  creatorId       String   @unique @map("creator_id")
  pendingAmount   Decimal  @default(0) @map("pending_amount") @db.Decimal(10, 2)
  availableAmount Decimal  @default(0) @map("available_amount") @db.Decimal(10, 2)
  withdrawnAmount Decimal  @default(0) @map("withdrawn_amount") @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@map("balances")
}

model WithdrawalRequest {
  id            String    @id @default(uuid())
  creatorId     String    @map("creator_id")
  amount        Decimal   @db.Decimal(10, 2)
  method        String    @db.VarChar(20)       // alipay / bankcard
  accountName   String    @map("account_name") @db.VarChar(50)
  accountNumber String    @map("account_number") @db.VarChar(100)
  bankName      String?   @map("bank_name") @db.VarChar(100)
  // 灵活用工平台占位字段（阶段1先存记录，API后续接入）
  flexTaskId    String?   @map("flex_task_id") @db.VarChar(100)
  flexStatus    String?   @map("flex_status") @db.VarChar(20)
  status        String    @default("pending") @db.VarChar(20)
  // pending / processing / paid / rejected / failed
  rejectReason  String?   @map("reject_reason") @db.VarChar(500)
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id])

  @@map("withdrawal_requests")
}

// ================================================================
// 第五组：机型与定制订单
// ================================================================

model MachineModel {
  id           String          @id @default(uuid())
  name         String
  description  String?
  ratios       String
  frameOptions String
  sizes        String
  previewImage String?
  videoUrl     String?         @map("video_url") @db.VarChar(500)
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  skus MachineModelSku[]

  @@map("machine_models")
}

model MachineModelSku {
  id           String       @id @default(uuid())
  modelId      String       @map("model_id")
  size         String       @db.VarChar(20)
  material     String       @db.VarChar(50)
  frameCount   Int          @map("frame_count")
  colorName    String       @map("color_name") @db.VarChar(50)
  colorHex     String       @map("color_hex") @db.VarChar(10)
  previewImage String?      @map("preview_image") @db.VarChar(500)
  price        Decimal      @default(0) @db.Decimal(10, 2)
  skuBarcode   String?      @map("sku_barcode") @db.VarChar(50)
  isActive     Boolean      @default(true) @map("is_active")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  model MachineModel @relation(fields: [modelId], references: [id])

  @@unique([modelId, size, material, frameCount, colorName])
  @@map("machine_model_skus")
}

model CustomizeOrder {
  id              String    @id @default(uuid())
  orderNo         String    @unique
  userId          String    @map("user_id")
  modelId         String    @map("model_id")
  modelName       String    @map("model_name")
  frameCount      Int       @map("frame_count")
  size            String
  material        String
  color           String
  colorName       String    @map("color_name")
  skuId           String    @map("sku_id")
  ossPath         String    @map("oss_path")
  frameUrls       String    @map("frame_urls")    // JSON数组
  status          String    @default("pending")
  // pending→paid→locked→processing→producing→shipped→received→aftersale/cancelled
  inventoryStatus String    @default("normal") @map("inventory_status") @db.VarChar(20)
  sourceType      String    @default("custom") @map("source_type")
  collabWorkId    String?   @map("collab_work_id")
  crmebOrderId    String?   @map("crmeb_order_id")
  assignedTo      String?   @map("assigned_to")
  receiverName    String?   @map("receiver_name")
  receiverPhone   String?   @map("receiver_phone")
  receiverAddress String?   @map("receiver_address")
  receiverCity    String?   @map("receiver_city")
  trackingNo      String?   @map("tracking_no")
  trackingCompany String?   @map("tracking_company")
  batchId         String?   @map("batch_id")
  seqNo           Int?      @map("seq_no")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("customize_orders")
}

// ================================================================
// 第六组：联名体系
// ================================================================

model CollabWork {
  id                String    @id @default(uuid())
  creatorId         String    @map("creator_id")
  orderNo           String    @map("order_no")
  title             String
  description       String?
  coverUrl          String?   @map("cover_url")
  animationFrames   String    @map("animation_frames") // JSON数组 OSS objectKey
  supportedSkus     String    @map("supported_skus")   // JSON数组 SKU ID
  sizes             String?   @db.Text                 // JSON数组 如["5x5cm","8x8cm"]
  framePackOssPath  String?   @map("frame_pack_oss_path") @db.VarChar(500)
  isNewbieWork      Boolean   @default(false) @map("is_newbie_work")
  newbieExpiredAt   DateTime? @map("newbie_expired_at")  // 审核通过后 +30天
  activityId        String?   @map("activity_id")
  isExclusiveWork   Boolean   @default(false) @map("is_exclusive_work")
  status            String    @default("pending")
  // pending / approved / rejected
  rejectReason      String?   @map("reject_reason")
  agreementSignedAt DateTime  @map("agreement_signed_at")
  approvedAt        DateTime? @map("approved_at")
  approvedBy        String?   @map("approved_by")
  revenueRate       Float     @default(0) @map("revenue_rate") // 审核时快照
  isOnShelf         Boolean   @default(false) @map("is_on_shelf")
  shelfAt           DateTime? @map("shelf_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  framePacks   CollabFramePack[]
  collabOrders CollabOrder[]

  @@map("collab_works")
}

model CollabOrder {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")       // 关联 customize_orders.id
  collabWorkId String    @map("collab_work_id")
  creatorId    String    @map("creator_id")

  salePrice     Float @map("sale_price")      // 成交价快照
  revenueRate   Float @map("revenue_rate")    // 分红率快照
  revenueAmount Float @map("revenue_amount")  // 应付分红 = salePrice × revenueRate

  // 储备金（初期固定15%）
  reserveRate   Float @default(0.15) @map("reserve_rate")
  reserveAmount Float @default(0)    @map("reserve_amount") // revenueAmount × reserveRate
  payoutAmount  Float @default(0)    @map("payout_amount")  // revenueAmount - reserveAmount

  // 分红状态机
  revenueStatus String    @default("estimated") @map("revenue_status") @db.VarChar(20)
  // estimated=预估(未收货) / cooling=冷却中(已收货,等15天) / available=可提现 / withdrawn=已提现
  coolingEndAt  DateTime? @map("cooling_end_at") // 收货确认时间 + 15天

  // 结算（管理端打款用）
  settlementStatus String    @default("pending") @map("settlement_status") @db.VarChar(20)
  // pending / settled
  settlementWeek   String?   @map("settlement_week") @db.VarChar(10) // 如 2026-W14
  settledAt        DateTime? @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")

  collabWork  CollabWork   @relation(fields: [collabWorkId], references: [id])
  reserveLogs ReserveLog[]

  @@map("collab_orders")
}

model CollabActivity {
  id          String   @id @default(uuid())
  name        String
  description String?
  revenueRate Float    @map("revenue_rate")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("collab_activities")
}

model CollabFramePack {
  id             String   @id @default(uuid())
  collabWorkId   String   @map("collab_work_id")
  size           String   @db.VarChar(20)
  ossPath        String?  @map("oss_path") @db.VarChar(500)
  localCachePath String?  @map("local_cache_path") @db.VarChar(500)
  stockType      String   @default("on_demand") @map("stock_type") @db.VarChar(20)
  currentStock   Int      @default(0) @map("current_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  collabWork CollabWork @relation(fields: [collabWorkId], references: [id])

  @@unique([collabWorkId, size])
  @@map("collab_frame_packs")
}

// ================================================================
// 第七组：库存与生产
// ================================================================

model SkuInventory {
  id            String   @id @default(uuid())
  skuId         String   @unique @map("sku_id")
  currentStock  Int      @default(0) @map("current_stock")
  reservedStock Int      @default(0) @map("reserved_stock")
  safetyStock   Int      @default(10) @map("safety_stock")
  maxOrderLimit Int      @default(100) @map("max_order_limit")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("sku_inventory")
}

model InventoryLog {
  id         String   @id @default(uuid())
  skuId      String   @map("sku_id")
  type       String   @db.VarChar(20) // in / out / reserved / released
  quantity   Int
  orderId    String?  @map("order_id")
  operatorId String   @map("operator_id")
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("inventory_logs")
}

model AuthCode {
  id            String    @id @default(uuid())
  code          String    @unique @db.VarChar(20)
  orderId       String    @map("order_id")
  skuId         String    @map("sku_id")
  issuedAt      DateTime  @map("issued_at")
  queriedCount  Int       @default(0) @map("queried_count")
  lastQueriedAt DateTime? @map("last_queried_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("auth_codes")
}

model ShippingBatch {
  id              String   @id @default(uuid())
  trackingNo      String?  @map("tracking_no")
  trackingCompany String?  @map("tracking_company")
  receiverName    String   @map("receiver_name")
  receiverPhone   String   @map("receiver_phone")
  receiverAddress String   @map("receiver_address")
  receiverCity    String   @map("receiver_city")
  status          String   @default("pending")
  orderCount      Int      @default(0) @map("order_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shipping_batches")
}

model OperationLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  userRole  Int      @map("user_role")
  action    String?
  method    String
  path      String
  target    String?
  targetId  String?  @map("target_id")
  before    String?  @db.Text
  after     String?  @db.Text
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("operation_logs")
}

// ================================================================
// 第八组：联络表单
// ================================================================

model ContactSubmission {
  id              String    @id @default(uuid())
  type            String    @db.VarChar(20)
  // artist / channel / media / join / feedback / factory
  name            String
  contact         String
  message         String    @db.Text
  extra           String?   @db.Text
  attachments     String?
  submitterUserId String?   @map("submitter_user_id")
  ip              String?
  userAgent       String?   @db.Text @map("user_agent")
  status          String    @default("pending") @db.VarChar(20)
  // pending / processing / done / spam
  isStarred       Boolean   @default(false) @map("is_starred")
  handledBy       String?   @map("handled_by")
  handledAt       DateTime? @map("handled_at")
  note            String?   @db.Text
  spamScore       Int       @default(0) @map("spam_score")
  isBlocked       Boolean   @default(false) @map("is_blocked")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([ip])
  @@index([createdAt])
  @@map("contact_submissions")
}

// ================================================================
// 第九组：创作者分红结算体系（3张表）
// ================================================================

// 创作者储备金账户，一人一条，实时余额快照
model CreatorReserve {
  id                String    @id @default(uuid())
  creatorId         String    @unique @map("creator_id")

  totalReserved     Float     @default(0) @map("total_reserved")      // 累计扣入储备金总额
  frozenAmount      Float     @default(0) @map("frozen_amount")        // 当前违规冻结中
  releasableAmount  Float     @default(0) @map("releasable_amount")    // 90天期内待释放
  releasedAmount    Float     @default(0) @map("released_amount")      // 已释放回余额累计

  nextReleaseAt     DateTime? @map("next_release_at")                  // 最近一批解冻时间
  nextReleaseAmount Float     @default(0) @map("next_release_amount")  // 最近一批待释放金额

  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  creator User         @relation(fields: [creatorId], references: [id])
  logs    ReserveLog[]

  @@map("creator_reserves")
}

// 储备金每一笔变动流水，完整可溯源
model ReserveLog {
  id            String    @id @default(uuid())
  creatorId     String    @map("creator_id")
  reserveId     String    @map("reserve_id")       // 关联 creator_reserves.id
  collabOrderId String?   @map("collab_order_id")  // 扣入时关联的联名订单

  actionType    String    @map("action_type") @db.VarChar(20)
  // deduct=扣入 / release=90天释放 / freeze=违规冻结 / unfreeze=解冻 / confiscate=没收

  amount        Float                              // 本次变动金额（正数）
  balanceAfter  Float     @map("balance_after")    // 变动后储备金余额
  releaseAt     DateTime? @map("release_at")       // 预计释放时间（deduct时 = 收货确认+90天）
  note          String?   @db.VarChar(200)

  createdAt     DateTime  @default(now()) @map("created_at")

  creator     User           @relation(fields: [creatorId], references: [id])
  reserve     CreatorReserve @relation(fields: [reserveId], references: [id])
  collabOrder CollabOrder?   @relation(fields: [collabOrderId], references: [id])

  @@index([creatorId])
  @@index([reserveId])
  @@index([releaseAt]) // 定时任务按此字段扫描到期释放
  @@map("reserve_logs")
}

// 管理员每次确认打款的凭证
model SettlementRecord {
  id              String    @id @default(uuid())
  settlementWeek  String    @map("settlement_week") @db.VarChar(10) // 如 2026-W14

  creatorId       String    @map("creator_id")
  orderCount      Int       @map("order_count")
  totalRevenue    Float     @map("total_revenue")      // 分红合计
  reserveDeducted Float     @map("reserve_deducted")   // 本批储备金扣除合计
  payoutAmount    Float     @map("payout_amount")       // 实际打入余额

  status          String    @default("pending") @db.VarChar(20)
  // pending=待打款 / paid=已打款 / failed=失败

  settledBy       String?   @map("settled_by")          // 操作管理员 userId
  settledAt       DateTime? @map("settled_at")
  note            String?   @db.VarChar(500)             // 如灵活用工平台任务单号

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator       User  @relation(fields: [creatorId], references: [id])
  settledByUser User? @relation("SettlementAdmin", fields: [settledBy], references: [id])

  @@unique([settlementWeek, creatorId]) // 同一周同一创作者只有一条
  @@index([settlementWeek])
  @@index([creatorId])
  @@map("settlement_records")
}
